@page "/roles"
@rendermode InteractiveServer
@attribute [Authorize]
@using WarehouseApp.Services
@using WarehouseApp.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AccessService Access
@inject ToastService Toasts

<PageTitle>نقش‌ها و دسترسی‌ها | WarehouseApp</PageTitle>

<h3 class="mb-3">🔐 نقش‌ها و دسترسی‌ها</h3>

@* ===== میزبان پیام‌های شناور ===== *@
<ToastHost Inline="true" />

@if (!allowed)
{
    <div class="alert alert-danger">شما اجازهٔ دسترسی به این بخش را ندارید.</div>
}
else
{
    @* ===== فرم افزودن / ویرایش ===== *@
    <div class="card p-3 mb-4">
        <h5 class="mb-3">@(editing is null ? "افزودن نقش جدید" : $"ویرایش نقش: {editing.Name}")</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">نام نقش</label>
                <input class="form-control" @bind="formName" placeholder="مثلاً حسابدار" />
            </div>
            <div class="col-md-6">
                <label class="form-label">توضیح (اختیاری)</label>
                <input class="form-control" @bind="formDescription" />
            </div>
            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="roleActive" @bind="formIsActive" />
                    <label class="form-check-label" for="roleActive">فعال</label>
                </div>
            </div>
        </div>

        <div class="alert alert-warning py-2 small mt-3 mb-0">
            ⚠️ <strong>توجه:</strong> اگر نقش را <strong>غیرفعال</strong> کنید، همهٔ کارمندانی که این نقش را دارند
            از دسترسی محروم می‌شوند: نه می‌توانند وارد شوند و نه اختیاری دارند.
            حسابشان پاک نمی‌شود؛ به‌محض فعال‌کردن دوبارهٔ نقش، دسترسی همه یک‌جا برمی‌گردد.
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>اختیارات این نقش</strong>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAll">انتخاب همه</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAll">پاک‌کردن همه</button>
            </div>
        </div>

        @foreach (var group in PermissionCatalog.Groups)
        {
            <div class="mb-3">
                <div class="text-muted small mb-1">@group</div>
                <div class="row">
                    @foreach (var item in PermissionCatalog.All.Where(p => p.Group == group))
                    {
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="@($"perm_{item.Value}")"
                                       checked="@Has(item.Value)"
                                       @onchange="e => SetPermission(item.Value, e.Value is bool b && b)" />
                                <label class="form-check-label" for="@($"perm_{item.Value}")">@item.Title</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mt-3">
            @if (editing is null)
            {
                <button type="button" class="btn btn-primary" @onclick="SaveAsync">افزودن نقش</button>
            }
            else
            {
                <button type="button" class="btn btn-success" @onclick="SaveAsync">ذخیره تغییرات</button>
                <button type="button" class="btn btn-secondary" @onclick="ResetForm">انصراف</button>
            }
        </div>
    </div>

    @* ===== فهرست نقش‌ها ===== *@
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>نام نقش</th>
                <th>توضیح</th>
                <th>اختیارات</th>
                <th>کارمندان</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in roles)
            {
                <tr>
                    <td>
                        @r.Name
                        @if (r.IsSystemRole)
                        {
                            <span class="badge bg-secondary ms-1">پیش‌فرض</span>
                        }
                    </td>
                    <td class="text-muted small">@r.Description</td>
                    <td>@CountPermissions(r.Permissions) از @PermissionCatalog.All.Count</td>
                    <td>@(employeeCounts.TryGetValue(r.Id, out var n) ? n : 0)</td>
                    <td>
                        @if (r.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">غیرفعال</span>
                        }
                    </td>
                    <td>
                        @if (r.Id == Role.AdminRoleId)
                        {
                            <span class="badge bg-primary">دسترسی کامل — قابل تغییر نیست</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-warning" @onclick="() => StartEdit(r)">ویرایش</button>
                            @if (!r.IsSystemRole)
                            {
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(r)">حذف</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool allowed;
    private List<Role> roles = new();
    private Dictionary<int, int> employeeCounts = new();

    private Role? editing;
    private string formName = string.Empty;
    private string formDescription = string.Empty;
    private bool formIsActive = true;
    private Permissions formPermissions = Permissions.None;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        allowed = await Access.HasAsync(user, Permissions.ManageRoles);

        if (!allowed)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        roles = await Db.Roles.OrderBy(r => r.Id).ToListAsync();

        employeeCounts = await Db.Employees
            .Where(e => e.RoleId != null)
            .GroupBy(e => e.RoleId!.Value)
            .Select(g => new { RoleId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.RoleId, x => x.Count);
    }

    private bool Has(Permissions p) => (formPermissions & p) == p;

    private void SetPermission(Permissions p, bool on)
    {
        if (on)
        {
            formPermissions |= p;
        }
        else
        {
            formPermissions &= ~p;
        }
    }

    private void SelectAll() => formPermissions = Permissions.All;

    private void ClearAll() => formPermissions = Permissions.None;

    private static int CountPermissions(Permissions p)
        => PermissionCatalog.All.Count(i => (p & i.Value) == i.Value);

    private void ResetForm()
    {
        editing = null;
        formName = string.Empty;
        formDescription = string.Empty;
        formIsActive = true;
        formPermissions = Permissions.None;
    }

    private void StartEdit(Role r)
    {
        editing = r;
        formName = r.Name;
        formDescription = r.Description ?? string.Empty;
        formIsActive = r.IsActive;
        formPermissions = r.Permissions;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(formName))
        {
            Toasts.ShowError("نام نقش نمی‌تواند خالی باشد");
            return;
        }

        // قاعدهٔ ایمنی: نقش «مدیر سیستم» باید همیشه اختیار مدیریت نقش‌ها را داشته باشد
        if (editing is not null && editing.Id == Role.AdminRoleId
            && (formPermissions & Permissions.ManageRoles) != Permissions.ManageRoles)
        {
            Toasts.ShowError("نقش «مدیر سیستم» باید همیشه اختیار «مدیریت نقش‌ها» را داشته باشد");
            return;
        }

        // قاعدهٔ ایمنی: نقش «مدیر سیستم» نباید غیرفعال شود         if (editing is not null && editing.Id == Role.AdminRoleId && !formIsActive)         {             Toasts.ShowError("نقش «مدیر سیستم» را نمی‌توان غیرفعال کرد");             return;         }

        var name = formName.Trim();
        var exists = await Db.Roles.AnyAsync(x => x.Name == name && (editing == null || x.Id != editing.Id));
        if (exists)
        {
            Toasts.ShowError("نقشی با این نام از قبل وجود دارد");
            return;
        }

        try
        {
            if (editing is null)
            {
                var role = new Role
                {
                    Name = name,
                    Description = formDescription,
                    IsActive = formIsActive,
                    Permissions = formPermissions
                };

                Db.Roles.Add(role);
                await Db.SaveChangesAsync();
                await AuditAsync("افزودن", role.Id, $"نقش «{role.Name}» ساخته شد");
                Toasts.ShowSuccess($"نقش «{role.Name}» ساخته شد");
            }
            else
            {
                editing.Name = name;
                editing.Description = formDescription;
                editing.IsActive = formIsActive;
                editing.Permissions = formPermissions;

                Db.Roles.Update(editing);
                await Db.SaveChangesAsync();
                await AuditAsync("ویرایش", editing.Id, $"نقش «{editing.Name}» ویرایش شد");
                Toasts.ShowSuccess($"نقش «{editing.Name}» ویرایش شد");
            }

            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ذخیره: {ex.Message}");
        }
    }

    private async Task DeleteAsync(Role r)
    {
        if (r.IsSystemRole)
        {
            Toasts.ShowError("نقش‌های پیش‌فرض سیستم قابل حذف نیستند");
            return;
        }

        if (employeeCounts.TryGetValue(r.Id, out var count) && count > 0)
        {
            Toasts.ShowError($"این نقش به {count} کارمند داده شده است و قابل حذف نیست");
            return;
        }

        try
        {
            Db.Roles.Remove(r);
            await Db.SaveChangesAsync();
            await AuditAsync("حذف", r.Id, $"نقش «{r.Name}» حذف شد");
            Toasts.ShowSuccess($"نقش «{r.Name}» حذف شد");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در حذف: {ex.Message}");
        }
    }

    private async Task AuditAsync(string action, int entityId, string details)
    {
        var username = AuthState is null ? null : (await AuthState).User.Identity?.Name;

        Db.AuditLogs.Add(new AuditLog
        {
            Action = action,
            Entity = "نقش",
            EntityId = entityId,
            Details = details,
            Username = username
        });

        await Db.SaveChangesAsync();
    }
}
