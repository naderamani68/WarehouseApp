@page "/sales"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using WarehouseApp.Data
@using WarehouseApp.Services
@inject ApplicationDbContext Db
@inject AccessService Access
@inject ToastService Toasts

@* پنل فروشنده: هر فروشنده فقط سفارش‌های خودش را می‌بیند، نه سفارش‌های دیگران *@

<PageTitle>سفارش‌های من</PageTitle>

<ToastHost Inline="true" />

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <div>
        <h1 class="mb-1">سفارش‌های من</h1>
        <p class="text-muted small mb-0">
            فقط سفارش‌هایی که با نام کاربری خودت ثبت شده‌اند اینجا نمایش داده می‌شوند.
        </p>
    </div>

    @if (canCreateOrder)
    {
        <a class="btn btn-primary" href="/crm/orders">
            <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>
            ثبت سفارش تازه
        </a>
    }
</div>

@if (!allowed)
{
    <div class="alert alert-warning mb-0">
        این بخش مخصوص فروشندگان است. اگر لازم داری، مدیر سیستم باید اختیار «پنل فروشندگان» را به نقش تو بدهد.
    </div>
}
else if (loading)
{
    <div class="text-center text-muted py-5">
        <span class="bi bi-hourglass-split me-1"></span>
        در حال بارگذاری…
    </div>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">تعداد سفارش</div>
                    <div class="fs-4 fw-bold">@Count(orders.Count)</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">پیش‌نویس</div>
                    <div class="fs-4 fw-bold text-warning">@Count(orders.Count(o => o.Status == OrderStatus.Draft))</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">تأییدشده</div>
                    <div class="fs-4 fw-bold text-success">@Count(orders.Count(o => o.Status == OrderStatus.Confirmed))</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">مبلغ کل</div>
                    <div class="fs-5 fw-bold text-primary">@Money(orders.Where(o => o.Status != OrderStatus.Canceled).Sum(o => o.Total)) ریال</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap gap-2 align-items-end">
            <div style="min-width:200px">
                <label class="form-label">وضعیت سفارش</label>
                <select class="form-select" @bind="filterStatus" @bind:after="LoadAsync">
                    <option value="0">همه</option>
                    <option value="@OrderStatus.Draft">پیش‌نویس</option>
                    <option value="@OrderStatus.Confirmed">تأییدشده</option>
                    <option value="@OrderStatus.Canceled">لغو‌شده</option>
                </select>
            </div>

            <button class="btn btn-outline-secondary" @onclick="LoadAsync">
                <span class="bi bi-arrow-clockwise me-1" aria-hidden="true"></span>
                بازخوانی
            </button>
        </div>
    </div>

    @if (orders.Count == 0)
    {
        <div class="alert alert-info mb-0">
            هنوز سفارشی با نام کاربری تو ثبت نشده است.
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>شمارهٔ سفارش</th>
                            <th>مشتری</th>
                            <th>تاریخ</th>
                            <th class="text-center">اقلام</th>
                            <th class="text-end">مبلغ کل</th>
                            <th class="text-center">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="fw-semibold" dir="ltr">@order.OrderNumber</td>
                                <td>@(order.Party?.Name ?? "—")</td>
                                <td class="small">@PersianDate.ToDate(order.OrderDate)</td>
                                <td class="text-center">@Count(order.TotalQuantity)</td>
                                <td class="text-end">@Money(order.Total)</td>
                                <td class="text-center">
                                    <span class="badge @order.StatusBadge">@order.StatusTitle</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="fw-semibold">جمع سفارش‌های نمایش‌داده‌شده</td>
                            <td class="text-end fw-bold">@Money(orders.Sum(o => o.Total))</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <p class="text-muted small mt-2 mb-0">
            برای تأیید سفارش و کسر از انبار، انباردار باید سفارش را تأیید کند.
        </p>
    }
}

@code {
    private static readonly CultureInfo Fa = new("fa-IR");

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool loading = true;
    private bool allowed;
    private bool canCreateOrder;
    private string? myUsername;
    private int filterStatus;
    private List<SalesOrder> orders = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            loading = false;
            return;
        }

        var user = (await AuthState).User;
        var permissions = await Access.GetPermissionsAsync(user);

        allowed = (permissions & Permissions.SalesPanel) == Permissions.SalesPanel;
        canCreateOrder = (permissions & Permissions.ManageCrm) == Permissions.ManageCrm;
        myUsername = user.Identity?.Name;

        if (!allowed)
        {
            loading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;

        var query = Db.SalesOrders
            .AsNoTracking()
            .Include(o => o.Party)
            .Include(o => o.Items)
            .Where(o => o.Username == myUsername);

        if (filterStatus > 0)
        {
            var status = (OrderStatus)filterStatus;
            query = query.Where(o => o.Status == status);
        }

        orders = await query
            .OrderByDescending(o => o.OrderDate)
            .ThenByDescending(o => o.Id)
            .ToListAsync();

        loading = false;
    }

    private static string Count(int value) => value.ToString("N0", Fa);

    private static string Money(decimal value) => value.ToString("N0", Fa).Replace(",", ".");
}
