@page "/categories"
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject IJSRuntime JS
@using WarehouseApp.Services
@using System.Globalization
@inject ExcelService Excel

<PageTitle>دسته‌بندی‌ها | WarehouseApp</PageTitle>

<h3 class="mb-3">📁 مدیریت دسته‌بندی محصولات</h3>

@* ===== پیام‌های موفقیت/خطا ===== *@
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@* ===== فرم افزودن/ویرایش ===== *@
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                @(editingCategory == null ? "➕ افزودن دسته جدید" : $"✏️ ویرایش دسته: {editingCategory.Name}")
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">نام دسته: <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="newName" placeholder="مثلاً: لوازم برقی" />
                </div>

                <div class="mb-3">
                    <label class="form-label">توضیحات:</label>
                    <textarea class="form-control" rows="3" @bind="newDescription"
                              placeholder="توضیحات اختیاری..."></textarea>
                </div>

                @if (editingCategory == null)
                {
                    <button class="btn btn-primary" @onclick="AddCategory">➕ افزودن</button>
                }
                else
                {
                    <button class="btn btn-success" @onclick="SaveEdit">💾 ذخیره تغییرات</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                }

            </div>
        </div>
    </div>
</div>
@* ===== جدول دسته‌ها ===== *@
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>📋 لیست دسته‌ها (@categories.Count)</span>
                <div class="d-flex gap-2" style="width: 60%;">
                    <input class="form-control form-control-sm"
                           placeholder="🔍 جستجو..."
                           @bind="searchTerm" @bind:event="oninput" />
                    <button class="btn btn-sm btn-success text-nowrap" @onclick="ExportExcel" disabled="@isExporting">
                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel"></i>
                            <span class="ms-1">Excel</span>
                        }
                    </button>
                </div>
            </div>
            <div class="card-body p-0">

                @if (loading)
                {
                    <div class="text-center p-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted">در حال بارگذاری...</div>
                    </div>
                }
                else if (!FilteredCategories.Any())
                {
                    <div class="text-center p-5 text-muted">
                        <div style="font-size: 3rem;">📭</div>
                        <p class="mt-2 mb-0">
                            @(string.IsNullOrWhiteSpace(searchTerm)
                                ? "هنوز هیچ دسته‌ای ثبت نشده است."
                                : "دسته‌ای با این عنوان پیدا نشد.")
                        </p>
                        @if (string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <small>برای شروع، از فرم سمت راست یک دسته اضافه کنید.</small>
                        }
                    </div>
                }
                else
                {
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>نام دسته</th>
                                <th>توضیحات</th>
                                <th style="width: 140px;" class="text-center">تعداد محصولات</th>
                                <th style="width: 180px;" class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int row = 1;
                            }
                            @foreach (var cat in FilteredCategories)
                            {
                                <tr>
                                    <td>@row</td>
                                    <td><strong>@cat.Name</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(cat.Description) ? "-" : cat.Description)</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@cat.ProductCount</span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-warning" @onclick="() => StartEdit(cat)">✏️ ویرایش</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(cat)">🗑️ حذف</button>
                                    </td>
                                </tr>
                                row++;
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>
</div>
@code {
    // ===== مدل نمایشی برای جدول =====
    private class CategoryListItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int ProductCount { get; set; }
    }

    // ===== حالت‌های صفحه =====
    private List<CategoryListItem> categories = new();
    private Category? editingCategory = null;
    private string? successMessage;
    private string? errorMessage;

    private string? newName;
    private string? newDescription;

    private string? searchTerm;
    private bool loading = true;

    private bool isExporting = false;   // 🆕

    // ===== فیلتر زنده =====
    private IEnumerable<CategoryListItem> FilteredCategories =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? categories
            : categories.Where(c =>
                c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (c.Description ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    // ===== چرخه‌ی حیات =====
    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
    }

    // ===== بارگذاری =====
    private async Task LoadCategories()
    {
        loading = true;
        categories = await Db.Categories
            .OrderBy(c => c.Name)
            .Select(c => new CategoryListItem
                {
                    Id = c.Id,
                    Name = c.Name,
                    Description = c.Description,
                    ProductCount = c.Products.Count
                })
            .ToListAsync();
        loading = false;
    }

    // ===== افزودن =====
    private async Task AddCategory()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            errorMessage = "نام دسته نمی‌تواند خالی باشد.";
            return;
        }

        try
        {
            var cat = new Category
                {
                    Name = newName.Trim(),
                    Description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim()
                };

            Db.Categories.Add(cat);
            await Db.SaveChangesAsync();
            await LoadCategories();

            successMessage = $"دسته «{cat.Name}» با موفقیت اضافه شد ✅";
            ResetForm();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در افزودن: {ex.Message}";
        }
    }

    // ===== شروع ویرایش =====
    private void StartEdit(CategoryListItem item)
    {
        editingCategory = new Category
            {
                Id = item.Id,
                Name = item.Name,
                Description = item.Description
            };
        newName = item.Name;
        newDescription = item.Description;
    }

    // ===== ذخیره‌ی ویرایش =====
    private async Task SaveEdit()
    {
        if (editingCategory == null) return;

        if (string.IsNullOrWhiteSpace(newName))
        {
            errorMessage = "نام دسته نمی‌تواند خالی باشد.";
            return;
        }

        try
        {
            var entity = await Db.Categories.FindAsync(editingCategory.Id);
            if (entity == null)
            {
                errorMessage = "دسته یافت نشد.";
                return;
            }

            entity.Name = newName.Trim();
            entity.Description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim();

            await Db.SaveChangesAsync();
            await LoadCategories();

            successMessage = $"دسته «{entity.Name}» با موفقیت ویرایش شد ✅";
            CancelEdit();
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در ویرایش: {ex.Message}";
        }
    }

    // ===== انصراف =====
    private void CancelEdit()
    {
        editingCategory = null;
        ResetForm();
    }

    // ===== حذف =====
    private async Task DeleteCategory(CategoryListItem item)
    {
        var message = $"آیا از حذف دسته «{item.Name}» مطمئن هستید؟";
        if (item.ProductCount > 0)
        {
            message += $"\n\n⚠️ این دسته {item.ProductCount} محصول دارد. محصولات بدون دسته خواهند شد.";
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", message);
        if (!confirmed) return;

        try
        {
            var entity = await Db.Categories.FindAsync(item.Id);
            if (entity == null) return;

            Db.Categories.Remove(entity);
            await Db.SaveChangesAsync();
            await LoadCategories();

            successMessage = $"دسته «{item.Name}» حذف شد 🗑️";
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در حذف: {ex.Message}";
        }
    }

    // ===== ریست فرم =====
    private void ResetForm()
    {
        newName = string.Empty;
        newDescription = string.Empty;
    }

    // ===== 🆕 خروجی Excel =====
    private async Task ExportExcel()
    {
        try
        {
            isExporting = true;

            // ✅ فقط دسته‌های فیلترشده (بر اساس جستجو)
            var data = FilteredCategories.ToList();

            var columns = new Dictionary<string, Func<CategoryListItem, object?>>
                {
                    ["کد"] = c => c.Id,
                    ["نام دسته"] = c => c.Name,
                    ["توضیحات"] = c => c.Description,
                    ["تعداد محصولات"] = c => c.ProductCount
                };

            // ===== ساخت عنوان پویا =====
            var titleParts = new List<string> { "گزارش دسته‌بندی محصولات" };

            // فیلتر جستجو
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                titleParts.Add($"جستجو: «{searchTerm}»");
            }

            // تاریخ شمسی
            titleParts.Add($"تاریخ: {GetPersianDateTimeString()}");

            var title = string.Join("  |  ", titleParts);

            // ===== خروجی =====
            var bytes = Excel.Export(data, "دسته‌بندی‌ها", columns, title);
            var base64 = Convert.ToBase64String(bytes);

            // نام فایل با تاریخ شمسی
            var pc = new PersianCalendar();
            var now = DateTime.Now;
            var fileName = $"Categories_{pc.GetYear(now):0000}{pc.GetMonth(now):00}{pc.GetDayOfMonth(now):00}_{now:HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            errorMessage = $"خطا در خروجی Excel: {ex.Message}";
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetPersianDateTimeString()
    {
        var pc = new PersianCalendar();
        var now = DateTime.Now;
        return $"{pc.GetYear(now):0000}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00} - {now:HH:mm}";
    }
}