@page "/account/logout"
@layout WarehouseApp.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject NavigationManager Nav

<PageTitle>خروج از حساب | WarehouseApp</PageTitle>

<div class="text-center">
    <div class="auth-logo">👋</div>
    <h4 class="mt-3 mb-2">خروج از حساب</h4>
    <p class="text-muted">آیا می‌خواهید از حساب کاربری خود خارج شوید؟</p>
</div>

<form method="post" @formname="logout" @onsubmit="SignOutAsync">
    <AntiforgeryToken />
    <div class="d-flex gap-2 justify-content-center">
        <button type="submit" class="btn btn-danger">بله، خارج شو</button>
        <a href="/" class="btn btn-secondary">انصراف</a>
    </div>
</form>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    private async Task SignOutAsync()
    {
        if (HttpContext is not null)
        {
            await HttpContext.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);
        }

        Nav.NavigateTo("/account/login", forceLoad: true);
    }
}
