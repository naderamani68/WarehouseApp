@page "/account/change-password"
@rendermode InteractiveServer
@attribute [Authorize]
@using WarehouseApp.Services
@inject AccessService Access
@inject AuthService Auth
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>تغییر رمز عبور | WarehouseApp</PageTitle>

<h3 class="mb-3">🔑 تغییر رمز عبور</h3>

@* ===== میزبان پیام‌های شناور ===== *@
<ToastHost Inline="true" />

@if (forced)
{
    <div class="alert alert-warning">
        برای ادامهٔ کار با سیستم، ابتدا باید رمز عبور خود را تغییر دهید.
    </div>
}

<div class="card p-3" style="max-width: 520px;">
    <div class="mb-3">
        <label class="form-label">رمز عبور فعلی</label>
        <input type="password" class="form-control" dir="ltr" data-latin-password="true"
               @bind="currentPassword" autocomplete="current-password" />
    </div>

    <div class="mb-3">
        <label class="form-label">رمز عبور جدید</label>
        <input type="password" class="form-control" dir="ltr" data-latin-password="true"
               @bind="newPassword" autocomplete="new-password" />
        <div class="form-text">حداقل ۶ کاراکتر — فقط حروف، عدد و نشانه‌های انگلیسی</div>
    </div>

    <div class="mb-3">
        <label class="form-label">تکرار رمز عبور جدید</label>
        <input type="password" class="form-control" dir="ltr" data-latin-password="true"
               @bind="confirmPassword" autocomplete="new-password" />
    </div>

    <button type="button" class="btn btn-success" @onclick="ChangeAsync">تغییر رمز عبور</button>

    @if (!forced)
    {
        <a href="/profile" class="btn btn-secondary ms-2">انصراف</a>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromQuery] public bool Forced { get; set; }

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool forced;

    protected override void OnInitialized() => forced = Forced;

    private async Task ChangeAsync()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            Toasts.ShowError("رمز عبور فعلی و رمز جدید را وارد کنید");
            return;
        }

        if (newPassword.Length < 6)
        {
            Toasts.ShowError("رمز عبور جدید باید حداقل ۶ کاراکتر باشد");
            return;
        }

        if (newPassword != confirmPassword)
        {
            Toasts.ShowError("رمز عبور جدید و تکرار آن یکسان نیستند");
            return;
        }

        var user = AuthState is null ? null : (await AuthState).User;
        var employeeId = AccessService.GetEmployeeId(user);

        if (employeeId is null)
        {
            Toasts.ShowError("کاربر شناسایی نشد. لطفاً دوباره وارد شوید");
            return;
        }

        var result = await Auth.ChangePasswordAsync(employeeId.Value, currentPassword, newPassword);

        if (!result.Success)
        {
            Toasts.ShowError(result.Error ?? "تغییر رمز عبور ناموفق بود");
            return;
        }

        Toasts.ShowSuccess("رمز عبور با موفقیت تغییر کرد");
        currentPassword = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;

        if (forced)
        {
            Nav.NavigateTo("/", forceLoad: true);
        }
    }
}
