@page "/shop"
@layout WarehouseApp.Components.Layout.ShopLayout
@using System.Globalization
@using WarehouseApp.Services
@inject ShopCatalogService Catalog
@inject IHttpContextAccessor Http

@* این صفحه عمداً بدون حالت تعاملی رندر می‌شود:
   بازدیدکنندهٔ ناشناس یک اتصال زندهٔ سروری اشغال نمی‌کند و موتور جستجو هم صفحه را می‌بیند. *@

<PageTitle>فروشگاه</PageTitle>

<HeadContent>
    <meta name="description" content="فهرست کالاهای موجود همراه با قیمت و موجودی — ثبت سفارش اینترنتی بدون نیاز به ثبت‌نام" />
</HeadContent>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="mb-1">کالاهای موجود</h1>
            <p class="text-muted mb-0 small">
                قیمت‌ها به ریال است — ثبت سفارش بدون نیاز به ثبت‌نام انجام می‌شود.
            </p>
        </div>
        <span class="shop-chip">@products.Count.ToString("N0", Fa) کالا</span>
    </div>

    @if (categories.Count > 0)
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="/shop" class="shop-chip text-decoration-none">همه</a>

            @foreach (var category in categories)
            {
                <a href="/shop?cat=@category.Id" class="shop-chip text-decoration-none">@category.Name</a>
            }
        </div>
    }

    @if (products.Count == 0)
    {
        <div class="alert alert-info mb-0">
            کالایی با این مشخصات پیدا نشد.
            <a href="/shop" class="ms-2">نمایش همهٔ کالاها</a>
        </div>
    }
    else
    {
        <div class="shop-grid">
            @foreach (var product in products)
            {
                <div class="shop-card">
                    <a href="/shop/product/@product.Id" class="text-decoration-none">
                        <div class="shop-card-img">
                            @if (!string.IsNullOrWhiteSpace(product.MainImage))
                            {
                                <img src="/@product.MainImage" alt="@product.Name"
                                     style="width:100%;height:140px;object-fit:cover" />
                            }
                            else
                            {
                                <span class="bi bi-box-seam" aria-hidden="true"></span>
                            }
                        </div>
                    </a>

                    <div class="shop-card-body">
                        <a href="/shop/product/@product.Id" class="text-decoration-none text-reset fw-semibold">
                            @product.Name
                        </a>

                        @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                        {
                            <div class="text-muted small">@product.CategoryName</div>
                        }

                        <div class="small text-muted">واحد: @product.UnitTitle</div>

                        <div class="d-flex justify-content-between align-items-center">
                            <span class="shop-price">@(product.Price > 0 ? Money(product.Price) + " ریال" : "تماس بگیرید")</span>

                            @if (product.InStock)
                            {
                                <span class="badge bg-success">موجود</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ناموجود</span>
                            }
                        </div>

                        @if (product.InStock)
                        {
                            <form method="post" action="/shop/cart/add" class="mt-auto">
                                <AntiforgeryToken />
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <input type="hidden" name="returnUrl" value="/shop" />
                                <button class="btn btn-primary btn-sm w-100" type="submit">
                                    <span class="bi bi-cart-plus me-1" aria-hidden="true"></span>
                                    افزودن به سبد
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private static readonly CultureInfo Fa = new("fa-IR");

    private List<ShopProductDto> products = new();
    private List<ShopCategoryDto> categories = new();

    protected override async Task OnInitializedAsync()
    {
        var query = Http.HttpContext?.Request.Query;

        var search = query?["q"].FirstOrDefault();
        var categoryId = int.TryParse(query?["cat"].FirstOrDefault(), out var parsed) ? parsed : (int?)null;

        categories = await Catalog.GetCategoriesAsync();
        products = await Catalog.GetProductsAsync(search, categoryId);
    }

    private static string Money(decimal value) => value.ToString("N0", Fa);
}