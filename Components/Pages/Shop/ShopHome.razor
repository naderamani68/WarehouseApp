@page "/shop"
@layout WarehouseApp.Components.Layout.ShopLayout
@using System.Globalization
@using WarehouseApp.Services
@inject ShopCatalogService Catalog

@* این صفحه عمداً بدون حالت تعاملی رندر می‌شود:
   بازدیدکنندهٔ ناشناس یک اتصال زندهٔ سروری اشغال نمی‌کند و موتور جستجو هم صفحه را می‌بیند. *@

<PageTitle>فروشگاه</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h1 class="mb-1">کالاهای موجود</h1>
            <p class="text-muted mb-0 small">
                قیمت‌ها به ریال است — برای ثبت سفارش کافی است با ما تماس بگیرید یا سفارش بگذارید.
            </p>
        </div>
        <span class="shop-chip">@products.Count.ToString("N0", Fa) کالا</span>
    </div>

    @if (loading)
    {
        <div class="text-center text-muted py-5">
            <span class="bi bi-hourglass-split me-1"></span>
            در حال بارگذاری…
        </div>
    }
    else if (products.Count == 0)
    {
        <div class="alert alert-info mb-0">
            هنوز کالای فعالی برای نمایش ثبت نشده است. کارمند انبار باید کالاها را در پنل ثبت کند.
        </div>
    }
    else
    {
        @if (categories.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                @foreach (var category in categories)
                {
                    <span class="shop-chip">@category.Name</span>
                }
            </div>
        }

        <div class="shop-grid">
            @foreach (var product in products)
            {
                <div class="shop-card">
                    <div class="shop-card-img">
                        <span class="bi bi-box-seam" aria-hidden="true"></span>
                    </div>

                    <div class="shop-card-body">
                        <div class="fw-semibold">@product.Name</div>

                        @if (!string.IsNullOrWhiteSpace(product.CategoryName))
                        {
                            <div class="text-muted small">@product.CategoryName</div>
                        }

                        <div class="small text-muted">واحد: @product.UnitTitle</div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <span class="shop-price">@Money(product.Price) ریال</span>

                            @if (product.InStock)
                            {
                                <span class="badge bg-success">موجود</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">ناموجود</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@code {
    private static readonly CultureInfo Fa = new("fa-IR");

    private List<ShopProductDto> products = new();
    private List<ShopCategoryDto> categories = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        categories = await Catalog.GetCategoriesAsync();
        products = await Catalog.GetProductsAsync();
        loading = false;
    }

    /// <summary>نمایش مبلغ با رقم فارسی</summary>
    private static string Money(decimal value) => value.ToString("N0", Fa);
}
