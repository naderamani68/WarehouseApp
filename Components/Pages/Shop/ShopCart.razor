@page "/shop/cart"
@layout WarehouseApp.Components.Layout.ShopLayout
@using System.Globalization
@using WarehouseApp.Services
@inject ShopCatalogService Catalog
@inject IHttpContextAccessor Http

<PageTitle>سبد خرید</PageTitle>

<div class="container py-4">

    <h1 class="mb-3">سبد خرید</h1>

    @if (errorCode is not null)
    {
        <div class="alert alert-warning">
            @switch (errorCode)
            {
                case "info":
                    <span>نام و شمارهٔ تلفن را کامل وارد کن.</span>
                    break;
                case "empty":
                    <span>کالاهای سبد دیگر موجود نیستند.</span>
                    break;
                case "stock":
                    <span>موجودی کالاهای سبد تمام شده است؛ لطفاً دوباره انتخاب کن.</span>
                    break;
                default:
                    <span>ثبت سفارش انجام نشد؛ لطفاً دوباره تلاش کن.</span>
                    break;
            }
        </div>
    }

    @if (lines.Count == 0)
    {
        <div class="alert alert-info">
            سبد خرید خالی است.
            <a href="/shop" class="ms-2">رفتن به فهرست کالاها</a>
        </div>
    }
    else
    {
        <div class="row g-4">

            <div class="col-12 col-lg-7">
                <div class="card">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>کالا</th>
                                    <th class="text-end">قیمت واحد</th>
                                    <th class="text-center" style="width:150px">تعداد</th>
                                    <th class="text-end">جمع</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr>
                                        <td>
                                            <a href="/shop/product/@line.Product.Id" class="shop-link">@line.Product.Name</a>
                                            <div class="text-muted small">@line.Product.UnitTitle</div>
                                        </td>
                                        <td class="text-end">@Money(line.Product.Price)</td>
                                        <td>
                                            <form method="post" action="/shop/cart/update" class="d-flex gap-1">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                                <input class="form-control form-control-sm" type="number" inputmode="numeric" data-digits-only="true"
                                                       name="quantity" value="@line.Quantity" min="0" max="999" />
                                                <button class="btn btn-sm btn-outline-secondary" type="submit" title="به‌روزرسانی">
                                                    <span class="bi bi-arrow-repeat" aria-hidden="true"></span>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end fw-semibold">@Money(line.Product.Price * line.Quantity)</td>
                                        <td class="text-center">
                                            <form method="post" action="/shop/cart/update">
                                                <AntiforgeryToken />
                                                <input type="hidden" name="productId" value="@line.Product.Id" />
                                                <input type="hidden" name="quantity" value="0" />
                                                <button class="btn btn-sm btn-outline-danger" type="submit" title="حذف">
                                                    <span class="bi bi-trash" aria-hidden="true"></span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-2">
                    <a href="/shop" class="btn btn-outline-secondary btn-sm">افزودن کالای دیگر</a>

                    <form method="post" action="/shop/cart/clear">
                        <AntiforgeryToken />
                        <button class="btn btn-outline-danger btn-sm" type="submit">خالی کردن سبد</button>
                    </form>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <div class="card">
                    <div class="card-header">اطلاعات خریدار و ثبت سفارش</div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">جمع کالاها</span>
                            <span class="fw-bold">@Money(total) ریال</span>
                        </div>

                        <form method="post" action="/shop/cart/checkout">
                            <AntiforgeryToken />

                            <div class="mb-2">
                                <label class="form-label">نام و نام خانوادگی</label>
                                <input class="form-control" name="name" required minlength="3" />
                            </div>

                            <div class="mb-2">
                                <label class="form-label">شمارهٔ تلفن همراه</label>
                                <input class="form-control" name="phone" required dir="ltr" inputmode="numeric" data-digits-only="true"
                                       maxlength="11" minlength="11" placeholder="09123456789" pattern="0[0-9۰-۹]{10}" />
                                <div class="form-text">با همین شماره می‌توانی وضعیت سفارش را پیگیری کنی.</div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label">نشانی تحویل</label>
                                <textarea class="form-control" name="address" rows="2" required minlength="10"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">یادداشت (اختیاری)</label>
                                <input class="form-control" name="note" />
                            </div>

                            <button class="btn btn-primary w-100" type="submit">
                                <span class="bi bi-check2-circle me-1" aria-hidden="true"></span>
                                ثبت سفارش
                            </button>
                        </form>

                        <p class="text-muted small mt-3 mb-0">
                            پس از ثبت، سفارش با وضعیت «در انتظار تأیید» ثبت می‌شود و همکاران ما برای
                            هماهنگی پرداخت و ارسال با تو تماس می‌گیرند.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    }

</div>

@code {
    private static readonly CultureInfo Fa = new("fa-IR");

    private List<CartLine> lines = new();
    private decimal total;
    private string? errorCode;

    protected override async Task OnInitializedAsync()
    {
        var context = Http.HttpContext;

        if (context is null)
        {
            return;
        }

        errorCode = context.Request.Query["error"].FirstOrDefault();

        var cart = WarehouseApp.Services.ShopCart.Read(context);

        if (cart.Count == 0)
        {
            return;
        }

        var products = await Catalog.GetProductsByIdsAsync(cart.Keys);

        lines = products
            .Select(p => new CartLine(p, cart[p.Id]))
            .ToList();

        total = lines.Sum(l => l.Product.Price * l.Quantity);
    }

    private static string Money(decimal value) => value.ToString("N0", Fa).Replace(",", ".");

    private record CartLine(ShopProductDto Product, int Quantity);
}
