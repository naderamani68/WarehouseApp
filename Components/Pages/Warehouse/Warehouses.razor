@page "/warehouses"
@attribute [Authorize]
@inherits PageBase
@rendermode InteractiveServer
@using WarehouseApp.Services
@using System.Globalization
@inject ExcelService Excel
@inject ToastService Toasts
@using WarehouseApp.Data
@using Microsoft.EntityFrameworkCore
@inject IJSRuntime JS

<h3>لیست انبارها</h3>

@* ===== دکمه‌ی خروجی Excel ===== *@
<div class="row mb-3">
    <div class="col-12 text-end">
        <button class="btn btn-success" @onclick="ExportExcel" disabled="@(!Can(Permissions.ExportExcel) || isExporting)">
            @if (isExporting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال ساخت...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel"></i>
                <span>خروجی اکسل</span>
            }
        </button>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>شناسه</th>
            <th>نام</th>
            <th>موقعیت</th>
            <th>توضیحات</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @if (warehouses.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">هیچ انباری وجود ندارد</td>
            </tr>
        }
        else
        {
            @foreach (var w in warehouses)
            {
                <tr>
                    <td>@w.Id</td>
                    <td>@w.Name</td>
                    <td>@(w.Location ?? "-")</td>
                    <td>@(w.Description ?? "-")</td>
                    <td>
                        @if (w.IsActive)
                        {
                            <span class="badge bg-success">فعال</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">غیرفعال</span>
                        }
                    </td>
                    <td>
                        @if (Can(Permissions.ManageWarehouses))
                        {
                            <button class="btn btn-sm btn-warning" @onclick="() => StartEdit(w)">
                                ویرایش
                            </button>
                        }
                        @if (Can(Permissions.DeleteWarehouses))
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteWarehouse(w)">
                                حذف
                            </button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h3>@(editingWarehouse == null ? "افزودن انبار جدید" : $"ویرایش انبار: {editingWarehouse.Name}")</h3>

<div class="mb-3">
    <label class="form-label">نام انبار:</label>
    <input class="form-control" @bind="newName" />
</div>

<div class="mb-3">
    <label class="form-label">موقعیت:</label>
    <input class="form-control" @bind="newLocation" />
</div>

<div class="mb-3">
    <label class="form-label">توضیحات:</label>
    <input class="form-control" @bind="newDescription" />
</div>

<div class="mb-3 form-check">
    <input class="form-check-input" type="checkbox" @bind="newIsActive" id="isActiveCheck" />
    <label class="form-check-label" for="isActiveCheck">
        فعال
    </label>
</div>

@if (editingWarehouse == null && Can(Permissions.ManageWarehouses))
{
    <button class="btn btn-primary" @onclick="AddWarehouse">افزودن</button>
}
else if (Can(Permissions.ManageWarehouses))
{
    <button class="btn btn-success" @onclick="SaveEdit">ذخیره تغییرات</button>
    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
}
@* ===== پیام‌های شناور — کنار دکمهٔ ثبت ===== *@
<ToastHost Inline="true" />

@code {
    private List<Warehouse> warehouses = new();
    private Warehouse? editingWarehouse;

    private string? newName;
    private string? newLocation;
    private string? newDescription;
    private bool newIsActive = true;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadWarehouses();
    }

    private async Task LoadWarehouses()
    {
        warehouses = await Db.Warehouses.OrderBy(w => w.Id).ToListAsync();
    }

    private async Task AddWarehouse()
    {
        if (!Can(Permissions.ManageWarehouses))
        {
            Toasts.ShowError("شما اجازهٔ افزودن انبار را ندارید");
            return;
        }

        if (string.IsNullOrWhiteSpace(newName))
        {
            Toasts.ShowError("نام انبار نمی‌تواند خالی باشد");
            return;
        }

        try
        {
            var warehouse = new Warehouse
                {
                    Name = newName,
                    Location = newLocation,
                    Description = newDescription,
                    IsActive = newIsActive
                };

            Db.Warehouses.Add(warehouse);
            await Db.SaveChangesAsync();
            await LoadWarehouses();

            await AuditAsync("افزودن", "انبار", warehouse.Id, $"انبار «{warehouse.Name}» ساخته شد");
            Toasts.ShowSuccess($"انبار «{warehouse.Name}» با موفقیت اضافه شد");
            ResetForm();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در افزودن: {ex.Message}");
        }
    }

    private void StartEdit(Warehouse w)
    {
        editingWarehouse = w;
        newName = w.Name;
        newLocation = w.Location;
        newDescription = w.Description;
        newIsActive = w.IsActive;
    }

    private async Task SaveEdit()
    {
        if (!Can(Permissions.ManageWarehouses))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش انبار را ندارید");
            return;
        }

        if (editingWarehouse == null) return;

        if (string.IsNullOrWhiteSpace(newName))
        {
            Toasts.ShowError("نام انبار نمی‌تواند خالی باشد");
            return;
        }

        try
        {
            editingWarehouse.Name = newName;
            editingWarehouse.Location = newLocation;
            editingWarehouse.Description = newDescription;
            editingWarehouse.IsActive = newIsActive;

            Db.Warehouses.Update(editingWarehouse);
            await Db.SaveChangesAsync();
            await LoadWarehouses();

            await AuditAsync("ویرایش", "انبار", editingWarehouse.Id, $"انبار «{editingWarehouse.Name}» ویرایش شد");
            Toasts.ShowSuccess($"انبار «{editingWarehouse.Name}» ویرایش شد");
            CancelEdit();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ویرایش: {ex.Message}");
        }
    }

    private void CancelEdit()
    {
        editingWarehouse = null;
        ResetForm();
    }

    private async Task DeleteWarehouse(Warehouse w)
    {
        if (!Can(Permissions.DeleteWarehouses))
        {
            Toasts.ShowError("شما اجازهٔ حذف انبار را ندارید");
            return;
        }

        try
        {
            Db.Warehouses.Remove(w);
            await Db.SaveChangesAsync();
            await LoadWarehouses();
            await AuditAsync("حذف", "انبار", w.Id, $"انبار «{w.Name}» حذف شد");
            Toasts.ShowSuccess($"انبار «{w.Name}» حذف شد");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در حذف: {ex.Message}");
        }
    }

    private void ResetForm()
    {
        newName = string.Empty;
        newLocation = string.Empty;
        newDescription = string.Empty;
        newIsActive = true;
    }

    private bool isExporting = false;

    private async Task ExportExcel()
    {
        if (!Can(Permissions.ExportExcel))
        {
            Toasts.ShowError("شما اجازهٔ گرفتن خروجی اکسل را ندارید");
            return;
        }

        try
        {
            isExporting = true;

            // ✅ همه‌ی انبارها (این صفحه فیلتر نداره)
            var data = warehouses;

            var columns = new Dictionary<string, Func<Warehouse, object?>>
                {
                    ["کد"] = w => w.Id,
                    ["نام انبار"] = w => w.Name,
                    ["موقعیت"] = w => w.Location,
                    ["توضیحات"] = w => w.Description,
                    ["وضعیت"] = w => w.IsActive ? "فعال" : "غیرفعال"
                };

            // ===== ساخت عنوان پویا =====
            var title = $"گزارش انبارها  |  تاریخ: {GetPersianDateTimeString()}";

            // ===== خروجی =====
            var bytes = Excel.Export(data, "انبارها", columns, title);
            var base64 = Convert.ToBase64String(bytes);

            // نام فایل با تاریخ شمسی
            var pc = new PersianCalendar();
            var now = DateTime.Now;
            var fileName = $"Warehouses_{pc.GetYear(now):0000}{pc.GetMonth(now):00}{pc.GetDayOfMonth(now):00}_{now:HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خروجی Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetPersianDateTimeString()
    {
        var pc = new PersianCalendar();
        var now = DateTime.Now;
        return $"{pc.GetYear(now):0000}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00} - {now:HH:mm}";
    }
}
