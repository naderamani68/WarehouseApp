    /// <summary>نمایش یا پنهان کردن کالا در فروشگاه اینترنتی</summary>
    private async Task ToggleShopVisibility(Product product)
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش کالا را ندارید");
            return;
        }

        var tracked = await Db.Products.FirstOrDefaultAsync(x => x.Id == product.Id);

        if (tracked is null)
        {
            return;
        }

        tracked.ShowInShop = !tracked.ShowInShop;
        await Db.SaveChangesAsync();

        Toasts.ShowSuccess(tracked.ShowInShop
            ? $"کالای «{tracked.Name}» در فروشگاه نمایش داده می‌شود"
            : $"کالای «{tracked.Name}» از فروشگاه پنهان شد");

        await LoadProducts();
    }

    /// <summary>ذخیرهٔ گالری عکس کالا — عکس‌های قبلی جانشین می‌شوند</summary>
    private async Task UploadGallery(InputFileChangeEventArgs e, Product product)
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش کالا را ندارید");
            return;
        }

        const int maxImages = 5;

        var files = e.GetMultipleFiles(maxImages);
        var saved = new List<string>();

        if (files.Count == 0)
        {
            return;
        }

        var folder = Path.Combine(Environment.WebRootPath, "uploads", "products");
        Directory.CreateDirectory(folder);

        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp", ".gif" };

        foreach (var file in files)
        {
            var extension = Path.GetExtension(file.Name).ToLowerInvariant();

            if (!allowed.Contains(extension) || file.Size > 3 * 1024 * 1024)
            {
                Toasts.ShowError($"عکس «{file.Name}» پذیرفته نشد؛ فقط عکس تا ۳ مگابایت");
                continue;
            }

            var fileName = $"g{product.Id}_{Guid.NewGuid():N}{extension}";
            var fullPath = Path.Combine(folder, fileName);

            await using (var stream = File.Create(fullPath))
            {
                await file.OpenReadStream(3 * 1024 * 1024).CopyToAsync(stream);
            }

            saved.Add($"uploads/products/{fileName}");
        }

        try
        {
            var old = await Db.ProductImages.Where(i => i.ProductId == product.Id).ToListAsync();

            foreach (var item in old)
            {
                var oldFull = Path.Combine(Environment.WebRootPath, item.Path.Replace('/', Path.DirectorySeparatorChar));

                if (File.Exists(oldFull))
                {
                    File.Delete(oldFull);
                }
            }

            Db.ProductImages.RemoveRange(old);

            for (var i = 0; i < saved.Count; i++)
            {
                Db.ProductImages.Add(new ProductImage
                {
                    ProductId = product.Id,
                    Path = saved[i],
                    SortOrder = i + 1
                });
            }

            await Db.SaveChangesAsync();

            Toasts.ShowSuccess($"گالری کالای «{product.Name}» با {saved.Count} عکس ذخیره شد");
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ذخیرهٔ گالری: {ex.Message}");
        }
    }

    /// <summary>ذخیرهٔ عکس کالا در پوشهٔ uploads/products — فقط برای کالاهای فعال</summary>
    private async Task UploadImage(InputFileChangeEventArgs e, Product product)
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش کالا را ندارید");
            return;
        }

        var file = e.File;

        if (file is null || file.Size == 0)
        {
            return;
        }

        if (file.Size > 3 * 1024 * 1024)
        {
            Toasts.ShowError("حجم عکس باید کمتر از ۳ مگابایت باشد");
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (extension is not (".jpg" or ".jpeg" or ".png" or ".webp" or ".gif"))
        {
            Toasts.ShowError("فقط عکس با قالب jpg یا png یا webp یا gif مجاز است");
            return;
        }

        try
        {
            var folder = Path.Combine(Environment.WebRootPath, "uploads", "products");
            Directory.CreateDirectory(folder);

            var fileName = $"{product.Id}_{Guid.NewGuid():N}{extension}";
            var fullPath = Path.Combine(folder, fileName);

            await using (var stream = File.Create(fullPath))
            {
                await file.OpenReadStream(3 * 1024 * 1024).CopyToAsync(stream);
            }

            var tracked = await Db.Products.FirstOrDefaultAsync(x => x.Id == product.Id);

            if (tracked is null)
            {
                Toasts.ShowError("کالا پیدا نشد");
                return;
            }

            var oldPath = tracked.ImagePath;
            tracked.ImagePath = $"uploads/products/{fileName}";
            await Db.SaveChangesAsync();

            if (!string.IsNullOrWhiteSpace(oldPath))
            {
                var oldFull = Path.Combine(Environment.WebRootPath, oldPath.Replace('/', Path.DirectorySeparatorChar));

                if (File.Exists(oldFull))
                {
                    File.Delete(oldFull);
                }
            }

            await LoadProducts();

            Toasts.ShowSuccess($"عکس کالای «{product.Name}» ذخیره شد");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ذخیرهٔ عکس: {ex.Message}");
        }
    }
