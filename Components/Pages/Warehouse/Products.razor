@page "/products"
@attribute [Authorize]
@inherits PageBase
@rendermode InteractiveServer
@inject IWebHostEnvironment Environment
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Environment
@using System.Globalization
@inject IWebHostEnvironment Environment
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Environment
@using WarehouseApp.Data
@inject IWebHostEnvironment Environment
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Environment
@using Microsoft.EntityFrameworkCore

@inject IWebHostEnvironment Environment
@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Environment
@using WarehouseApp.Services
@inject ExcelService Excel
@inject ToastService Toasts
@inject IJSRuntime JS

<h3>📦 شناسنامهٔ کالاها</h3>

@if (lowStockCount > 0)
{
    <div class="alert alert-warning">
        ⚠️ <strong>@lowStockCount.ToString("N0", Fa) کالا</strong> به حد سفارش رسیده یا تمام شده است.
        برای دیدنشان فیلتر «نیاز به سفارش» را انتخاب کن.
    </div>
}

@* ===== نوار فیلترها ===== *@
<div class="row mb-3 g-2">
    <div class="col-md-3">
        <input class="form-control" placeholder="🔍 جستجو در نام، کد یا توضیحات..."
               @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="categoryFilter">
            <option value="">— همه دسته‌ها —</option>
            <option value="0">— بدون دسته —</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="stockFilter">
            <option value="">— همه وضعیت‌ها —</option>
            <option value="low">نیاز به سفارش (کم یا ناموجود)</option>
            <option value="out">ناموجود</option>
            <option value="ok">موجودی سالم</option>
            <option value="inactive">غیرفعال</option>
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="pageSize">
            <option value="5">۵ در صفحه</option>
            <option value="10">۱۰ در صفحه</option>
            <option value="20">۲۰ در صفحه</option>
            <option value="50">۵۰ در صفحه</option>
        </select>
    </div>
</div>

@* ===== دکمه‌ی خروجی Excel + راهنما ===== *@
<div class="row mb-3 align-items-center">
    <div class="col-md-8">
        <details class="stock-help">
            <summary>❓ راهنمای وضعیت موجودی</summary>
            <div class="stock-help-content">
                <p class="mb-2">
                    📊 نوار موجودی نشون می‌ده هر محصول <strong>چقدر از بیشترین موجودی جدول</strong> رو داره.
                </p>
                <ul class="mb-2">
                    <li>🟢 <strong>سبز (۶۷٪ تا ۱۰۰٪)</strong> — موجودی خوب</li>
                    <li>🟡 <strong>زرد (۳۴٪ تا ۶۶٪)</strong> — موجودی متوسط</li>
                    <li>🔴 <strong>قرمز (۰٪ تا ۳۳٪)</strong> — موجودی کم</li>
                </ul>
                <p class="mb-0 text-muted small">
                    💡 <strong>حد سفارش</strong> با درصد فرق دارد: حد سفارش عددی است که خودت تعیین می‌کنی
                    (مثلاً ۱۰ کارتن) و وقتی موجودی به آن رسید، هشدار داده می‌شود.
                </p>
            </div>
        </details>
    </div>
    <div class="col-md-4 text-end">
        <label for="productImportFile" class="btn btn-outline-success mb-0" title="ورود گروهی کالاها از فایل اکسل">
            <i class="bi bi-upload me-1"></i>
            ورود از اکسل
        </label>
        <InputFile id="productImportFile" OnChange="ImportProducts" accept=".xlsx,.xlsm" class="d-none" />
        <label for="priceImportFile" class="btn btn-outline-success mb-0" title="ورود قیمت‌ها از فایل اکسل — ستون‌های کد و قیمت فروش و بهای خرید">
            <span class="bi bi-cash-coin me-1" aria-hidden="true"></span>
            ورود قیمت‌ها
        </label>
        <InputFile id="priceImportFile" OnChange="ImportPrices" accept=".xlsx,.xlsm" class="d-none" />
        <button class="btn btn-outline-secondary mb-0" @onclick="DownloadProductTemplate" title="فایل نمونهٔ ورود گروهی کالاها">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>
            نمونهٔ کالاها
        </button>
        <button class="btn btn-outline-secondary mb-0" @onclick="DownloadPriceTemplate" title="فایل نمونهٔ ورود قیمت‌ها">
            <i class="bi bi-file-earmark-arrow-down me-1"></i>
            نمونهٔ قیمت‌ها
        </button>
        <button class="btn btn-success" @onclick="ExportExcel" disabled="@(!Can(Permissions.ExportExcel) || isExporting)">
            @if (isExporting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال ساخت...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel"></i>
                <span>خروجی Excel</span>
            }
        </button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>کد</th>
                <th>نام کالا</th>
                <th>دسته</th>
                <th>واحد</th>
                <th>قیمت فروش</th>
                <th>بهای خرید</th>
                <th>سود واحد</th>
                <th>موجودی</th>
                <th>حد سفارش</th>
                <th>عکس</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @if (pagedProducts.Count == 0)
            {
                <tr>
                    <td colspan="12" class="text-center text-muted">هیچ کالایی با این فیلترها پیدا نشد</td>
                </tr>
            }
            else
            {
                @foreach (var product in pagedProducts)
                {
                    <tr class="@(product.IsOutOfStock ? "table-danger" : product.IsLow ? "table-warning" : "")">
                        <td class="small" dir="ltr">@(string.IsNullOrWhiteSpace(product.Code) ? product.Id.ToString() : product.Code)</td>
                        <td>
                            <div>@product.Name</div>
                            @if (!product.IsActive)
                            {
                                <span class="badge bg-secondary">غیرفعال</span>
                            }
                            @if (!product.ShowInShop)
                            {
                                <span class="badge bg-secondary">پنهان از فروشگاه</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(product.Barcode))
                            {
                                <div class="text-muted small" dir="ltr">@product.Barcode</div>
                            }
                        </td>
                        <td>
                            @if (product.Category != null)
                            {
                                <span class="badge bg-info text-dark">@product.Category.Name</span>
                            }
                            else
                            {
                                <span class="text-muted small">— بدون دسته —</span>
                            }
                        </td>
                        <td class="small">@product.UnitTitle</td>
                        <td class="small">@Money(product.SalePrice)</td>
                        <td class="small">@Money(product.CostPrice)</td>
                        <td class="small">
                            @if (product.CostPrice > 0 || product.SalePrice > 0)
                            {
                                <div class="@(product.ProfitPerUnit >= 0 ? "text-success" : "text-danger")">@Money(product.ProfitPerUnit)</div>
                                <div class="text-muted">@product.ProfitPercent.ToString("N1", Fa)٪</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td style="min-width:130px">
                            <div>@product.Quantity.ToString("N0", Fa) @product.UnitTitle</div>
                            <div class="stock-bar">
                                <div class="stock-bar-fill @GetProgressColor(product)"
                                     style="width: @GetProgressPercent(product)%">
                                </div>
                            </div>
                        </td>
                        <td class="small">@(product.ReorderLevel > 0 ? product.ReorderLevel.ToString("N0", Fa) + " " + product.UnitTitle : "—")</td>
                        <td style="width:78px">
                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="/@product.ImagePath" alt="@product.Name"
                                     style="width:54px;height:54px;object-fit:cover;border-radius:8px" />
                            }
                            <label for="@("img_" + product.Id)" class="btn btn-sm btn-outline-secondary mb-0 @(product.ImagePath is null ? "" : "mt-1")" title="انتخاب عکس کالا">
                                <span class="bi bi-image" aria-hidden="true"></span>
                            </label>
                            <InputFile id="@("img_" + product.Id)" OnChange="e => UploadImage(e, product)" accept="image/*" class="d-none" />
                            <label for="@("gal_" + product.Id)" class="btn btn-sm btn-outline-secondary mb-0 mt-1" title="انتخاب چند عکس (گالری)">
                                <span class="bi bi-images" aria-hidden="true"></span>
                            </label>
                            <InputFile id="@("gal_" + product.Id)" OnChange="e => UploadGallery(e, product)" accept="image/*" multiple class="d-none" />
                        </td>
                        <td>
                            <span class="badge @product.StockBadge">@product.StockStatus</span>
                        </td>
                        <td>
                            @if (Can(Permissions.ManageProducts))
                            {
                                <button class="btn btn-sm @(product.ShowInShop ? "btn-outline-info" : "btn-outline-secondary") me-1"
                                        @onclick="() => ToggleShopVisibility(product)"
                                        title="@(product.ShowInShop ? "پنهان کردن از فروشگاه" : "نمایش در فروشگاه")">
                                    <span class="bi @(product.ShowInShop ? "bi-eye" : "bi-eye-slash")" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => StartEdit(product)">ویرایش</button>
                            }
                            @if (Can(Permissions.DeleteProducts))
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteProduct(product)">حذف</button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => currentPage--">قبلی</button>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNum = i;
                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                    <button class="page-link" @onclick="() => currentPage = pageNum">@pageNum</button>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button class="page-link" @onclick="() => currentPage++">بعدی</button>
            </li>
        </ul>
    </nav>
}

<h3 class="mt-4">@(editingProduct == null ? "افزودن کالای جدید" : $"ویرایش کالا: {editingProduct.Name}")</h3>

<div class="card p-3">
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">نام کالا <span class="text-danger">*</span></label>
            <input class="form-control" @bind="form.Name" />
        </div>
        <div class="col-md-3">
            <label class="form-label">کد کالا</label>
            <input class="form-control" dir="ltr" @bind="form.Code" placeholder="مثلاً ۱۰۰۱" />
        </div>
        <div class="col-md-3">
            <label class="form-label">بارکد (اختیاری)</label>
            <input class="form-control" dir="ltr" @bind="form.Barcode" />
        </div>

        <div class="col-md-3">
            <label class="form-label">دسته‌بندی</label>
            <select class="form-select" @bind="form.CategoryId">
                <option value="">— بدون دسته —</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">واحد شمارش</label>
            <select class="form-select" @bind="form.Unit">
                <option value="@ProductUnit.Number">عدد</option>
                <option value="@ProductUnit.Carton">کارتن</option>
                <option value="@ProductUnit.Kilogram">کیلوگرم</option>
                <option value="@ProductUnit.Liter">لیتر</option>
                <option value="@ProductUnit.Pack">بسته</option>
                <option value="@ProductUnit.Box">جعبه</option>
                <option value="@ProductUnit.Meter">متر</option>
                <option value="@ProductUnit.Service">خدمت</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">قیمت فروش هر واحد (ریال)</label>
            <MoneyInput Value="@form.SalePrice" ValueChanged="v => form.SalePrice = v ?? string.Empty" />
        </div>
        <div class="col-md-3">
            <label class="form-label">بهای خرید هر واحد (ریال)</label>
            <MoneyInput Value="@form.CostPrice" ValueChanged="v => form.CostPrice = v ?? string.Empty" />
        </div>

        <div class="col-md-3">
            <label class="form-label">حد سفارش (هشدار کمبود)</label>
            <NumberInput T="string" CssClass="form-control" Value="@form.ReorderLevel" ValueChanged="v => form.ReorderLevel = v" MaxLength="9" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="isActive" @bind="form.IsActive" />
                <label class="form-check-label" for="isActive">کالای فعال</label>
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">توضیحات</label>
            <input class="form-control" @bind="form.Description" />
        </div>

        @if (formProfit is not null)
        {
            <div class="col-12">
                <div class="alert alert-info mb-0 py-2">
                    سود هر واحد: <strong>@Money(formProfit.Value)</strong>
                    @if (formProfitPercent is not null)
                    {
                        <span> — درصد سود: <strong>@formProfitPercent.Value.ToString("N1", Fa)٪</strong></span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="mt-3 d-flex gap-2">
        @if (editingProduct == null && Can(Permissions.ManageProducts))
        {
            <button class="btn btn-primary" @onclick="AddProduct">افزودن کالا</button>
        }
        else if (Can(Permissions.ManageProducts))
        {
            <button class="btn btn-success" @onclick="SaveEdit">ذخیره تغییرات</button>
            <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
        }
    </div>
</div>

@* ===== پیام‌های شناور — کنار دکمهٔ ثبت ===== *@
<ToastHost Inline="true" />

<div class="alert alert-info mt-3">
    💡 <strong>توجه:</strong> موجودی کالا از طریق ثبت «حرکات انبار» تغییر می‌کند.
    قیمت فروش و بهای خرید اینجا ثبت می‌شوند تا در سفارش فروش خودکار پر شوند و سود کالا محاسبه شود.
</div>

@code {
    private static readonly CultureInfo Fa = CultureInfo.GetCultureInfo("fa-IR");

    private List<Product> products = new();
    private List<Category> categories = new();
    private Product? editingProduct = null;

    private ProductForm form = new();
    private string? searchTerm;
    private string? categoryFilter;
    private string? stockFilter;
    private int pageSize = 10;
    private int currentPage = 1;
    private int _maxQuantity = 1;

    private int lowStockCount => products.Count(p => p.IsActive && (p.IsLow || p.IsOutOfStock));

    private decimal? formProfit
    {
        get
        {
            var sale = ParseNum(form.SalePrice);
            var cost = ParseNum(form.CostPrice);
            return sale == 0 && cost == 0 ? null : sale - cost;
        }
    }

    private decimal? formProfitPercent
    {
        get
        {
            var sale = ParseNum(form.SalePrice);
            var cost = ParseNum(form.CostPrice);
            return cost <= 0 ? null : Math.Round((sale - cost) / cost * 100m, 1);
        }
    }

    private List<Product> filteredProducts =>
        products
            .Where(p =>
                (string.IsNullOrWhiteSpace(searchTerm) ||
                 (p.Name != null && p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                 (p.Code != null && p.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                 (p.Barcode != null && p.Barcode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                 (p.Description != null && p.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                &&
                (string.IsNullOrEmpty(categoryFilter) ||
                 (categoryFilter == "0" && p.CategoryId == null) ||
                 (categoryFilter != "0" && p.CategoryId != null && p.CategoryId.ToString() == categoryFilter))
                &&
                (string.IsNullOrEmpty(stockFilter) ||
                 (stockFilter == "low" && (p.IsLow || p.IsOutOfStock)) ||
                 (stockFilter == "out" && p.IsOutOfStock) ||
                 (stockFilter == "ok" && !p.IsLow && !p.IsOutOfStock) ||
                 (stockFilter == "inactive" && !p.IsActive))
            )
            .ToList();

    private List<Product> pagedProducts =>
        filteredProducts.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();

    private int totalPages =>
        (int)Math.Ceiling((double)filteredProducts.Count / pageSize);

    protected override async Task OnPageInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadCategories()
    {
        categories = await Db.Categories.OrderBy(c => c.Name).ToListAsync();
    }

    private async Task LoadProducts()
    {
        products = await Db.Products
            .Include(p => p.Category)
            .OrderBy(p => p.Id)
            .ToListAsync();

        _maxQuantity = products.Any() ? products.Max(p => p.Quantity) : 1;
        if (_maxQuantity < 1) _maxQuantity = 1;
    }

    private async Task AddProduct()
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ افزودن کالا را ندارید");
            return;
        }

        if (string.IsNullOrWhiteSpace(form.Name))
        {
            Toasts.ShowError("نام کالا نمی‌تواند خالی باشد");
            return;
        }

        var code = string.IsNullOrWhiteSpace(form.Code) ? null : form.Code.Trim();

        if (code != null && await Db.Products.AnyAsync(p => p.Code == code))
        {
            Toasts.ShowError("این کد کالا قبلاً ثبت شده است");
            return;
        }

        try
        {
            var product = new Product
            {
                Name = form.Name.Trim(),
                Code = code,
                Barcode = NullIfEmpty(form.Barcode),
                Description = NullIfEmpty(form.Description),
                Quantity = 0,
                Unit = form.Unit,
                SalePrice = ParseNum(form.SalePrice),
                CostPrice = ParseNum(form.CostPrice),
                ReorderLevel = (int)ParseNum(form.ReorderLevel),
                IsActive = form.IsActive,
                CategoryId = form.CategoryId,
                CreatedAt = DateTime.Now
            };

            Db.Products.Add(product);
            await Db.SaveChangesAsync();
            await LoadProducts();

            await AuditAsync("افزودن", "کالا", product.Id,
                $"کالا «{product.Name}» با واحد {product.UnitTitle} و قیمت فروش {Money(product.SalePrice)} ساخته شد");

            Toasts.ShowSuccess($"کالای «{product.Name}» اضافه شد");
            ResetForm();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در افزودن: {ex.Message}");
        }
    }

    private void StartEdit(Product product)
    {
        editingProduct = product;

        form = new ProductForm
        {
            Name = product.Name,
            Code = product.Code,
            Barcode = product.Barcode,
            Description = product.Description,
            CategoryId = product.CategoryId,
            Unit = product.Unit,
            SalePrice = product.SalePrice.ToString(CultureInfo.InvariantCulture),
            CostPrice = product.CostPrice.ToString(CultureInfo.InvariantCulture),
            ReorderLevel = product.ReorderLevel.ToString(CultureInfo.InvariantCulture),
            IsActive = product.IsActive
        };
    }

    private async Task SaveEdit()
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش کالا را ندارید");
            return;
        }

        if (editingProduct == null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(form.Name))
        {
            Toasts.ShowError("نام کالا نمی‌تواند خالی باشد");
            return;
        }

        var code = string.IsNullOrWhiteSpace(form.Code) ? null : form.Code.Trim();

        if (code != null && await Db.Products.AnyAsync(p => p.Code == code && p.Id != editingProduct.Id))
        {
            Toasts.ShowError("این کد کالا برای کالای دیگری ثبت شده است");
            return;
        }

        try
        {
            editingProduct.Name = form.Name.Trim();
            editingProduct.Code = code;
            editingProduct.Barcode = NullIfEmpty(form.Barcode);
            editingProduct.Description = NullIfEmpty(form.Description);
            editingProduct.CategoryId = form.CategoryId;
            editingProduct.Unit = form.Unit;
            editingProduct.SalePrice = ParseNum(form.SalePrice);
            editingProduct.CostPrice = ParseNum(form.CostPrice);
            editingProduct.ReorderLevel = (int)ParseNum(form.ReorderLevel);
            editingProduct.IsActive = form.IsActive;

            await Db.SaveChangesAsync();
            await LoadProducts();

            await AuditAsync("ویرایش", "کالا", editingProduct.Id, $"شناسنامهٔ کالا «{editingProduct.Name}» ویرایش شد");
            Toasts.ShowSuccess($"کالای «{editingProduct.Name}» ویرایش شد");
            CancelEdit();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ویرایش: {ex.Message}");
        }
    }

    private void CancelEdit()
    {
        editingProduct = null;
        ResetForm();
    }

    private async Task DeleteProduct(Product product)
    {
        if (!Can(Permissions.DeleteProducts))
        {
            Toasts.ShowError("شما اجازهٔ حذف کالا را ندارید");
            return;
        }

        try
        {
            Db.Products.Remove(product);
            await Db.SaveChangesAsync();
            await LoadProducts();
            await AuditAsync("حذف", "کالا", product.Id, $"کالا «{product.Name}» حذف شد");
            Toasts.ShowSuccess($"کالای «{product.Name}» حذف شد");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در حذف: {ex.Message} — اگر این کالا در سفارش یا هزینه استفاده شده، به‌جای حذف آن را «غیرفعال» کن");
        }
    }

