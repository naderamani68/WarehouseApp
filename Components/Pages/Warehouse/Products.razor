    private async Task ImportProducts(InputFileChangeEventArgs e)
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ افزودن کالا را ندارید");
            return;
        }

        if (e.File is null)
        {
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);
            using var workbook = new ClosedXML.Excel.XLWorkbook(stream);
            var sheet = workbook.Worksheets.FirstOrDefault();

            if (sheet is null)
            {
                Toasts.ShowError("فایل اکسل هیچ برگه‌ای ندارد");
                return;
            }

            var categories = await Db.Categories.ToListAsync();
            var added = 0;
            var updated = 0;
            var skipped = 0;

            foreach (var row in sheet.RowsUsed().Skip(1))
            {
                var code = row.Cell(1).GetString().Trim();
                var name = row.Cell(2).GetString().Trim();

                if (string.IsNullOrWhiteSpace(name))
                {
                    skipped++;
                    continue;
                }

                var product = string.IsNullOrWhiteSpace(code)
                    ? null
                    : await Db.Products.FirstOrDefaultAsync(x => x.Code == code);

                if (product is null)
                {
                    product = new Product
                    {
                        Code = string.IsNullOrWhiteSpace(code) ? null : code,
                        CreatedAt = DateTime.Now
                    };
                    Db.Products.Add(product);
                    added++;
                }
                else
                {
                    updated++;
                }

                product.Name = name;
                product.Unit = ParseUnitText(row.Cell(3).GetString());

                var salePrice = ParseNum(row.Cell(4).GetString());
                if (salePrice > 0)
                {
                    product.SalePrice = salePrice;
                }

                var costPrice = ParseNum(row.Cell(5).GetString());
                if (costPrice > 0)
                {
                    product.CostPrice = costPrice;
                }

                var quantity = ParseNum(row.Cell(6).GetString());
                if (quantity > 0)
                {
                    product.Quantity = (int)quantity;
                }

                var reorder = ParseNum(row.Cell(7).GetString());
                if (reorder > 0)
                {
                    product.ReorderLevel = (int)reorder;
                }

                var categoryName = row.Cell(8).GetString().Trim();
                if (!string.IsNullOrWhiteSpace(categoryName))
                {
                    var category = categories.FirstOrDefault(c => c.Name == categoryName);
                    if (category is null)
                    {
                        category = new Category { Name = categoryName };
                        Db.Categories.Add(category);
                        categories.Add(category);
                    }

                    product.Category = category;
                }
            }

            await Db.SaveChangesAsync();
            await LoadProducts();

            Toasts.ShowSuccess($"ورود از اکسل انجام شد: {added} کالای تازه، {updated} کالای به‌روزشده، {skipped} ردیف بی‌نام");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خواندن فایل اکسل: {ex.Message}");
        }
    }

    /// <summary>تبدیل متن واحد کالا به مقدار شمارشی</summary>
    private static ProductUnit ParseUnitText(string text)
    {
        return (text ?? string.Empty).Trim() switch
        {
            "کارتن" => ProductUnit.Carton,
            "کیلوگرم" or "کیلو" => ProductUnit.Kilogram,
            "لیتر" => ProductUnit.Liter,
            "بسته" => ProductUnit.Pack,
            "جعبه" => ProductUnit.Box,
            "متر" => ProductUnit.Meter,
            "خدمت" or "خدمات" => ProductUnit.Service,
            _ => ProductUnit.Number
        };
    }
    /// <summary>
    /// ورود دسته‌جمعی قیمت‌ها از فایل اکسل.
    /// ستون‌های «کد» و «قیمت فروش» و «بهای خرید» شناخته می‌شوند؛
    /// همین فایل خروجی خود برنامه را می‌توان ویرایش کرد و برگرداند.
    /// </summary>
    private async Task ImportPrices(InputFileChangeEventArgs e)
    {
        if (!Can(Permissions.ManageProducts))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش کالا را ندارید");
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(20 * 1024 * 1024);
            using var workbook = new ClosedXML.Excel.XLWorkbook(stream);

            var sheet = workbook.Worksheets.FirstOrDefault();

            if (sheet is null)
            {
                Toasts.ShowError("فایل اکسل خالی است");
                return;
            }

            var header = sheet.Row(1);
            var codeColumn = 0;
            var saleColumn = 0;
            var costColumn = 0;

            foreach (var cell in header.CellsUsed())
            {
                var text = cell.GetString().Trim();

                if (codeColumn == 0 && text.Contains("کد"))
                {
                    codeColumn = cell.Address.ColumnNumber;
                }
                else if (saleColumn == 0 && text.Contains("فروش"))
                {
                    saleColumn = cell.Address.ColumnNumber;
                }
                else if (costColumn == 0 && (text.Contains("بها") || text.Contains("خرید")))
                {
                    costColumn = cell.Address.ColumnNumber;
                }
            }

            if (codeColumn == 0 || (saleColumn == 0 && costColumn == 0))
            {
                Toasts.ShowError("ستون «کد» و یکی از ستون‌های «قیمت فروش» یا «بهای خرید» در فایل پیدا نشد");
                return;
            }

            var updated = 0;
            var missing = 0;

            foreach (var row in sheet.RowsUsed().Skip(1))
            {
                var code = row.Cell(codeColumn).GetString().Trim();

                if (string.IsNullOrWhiteSpace(code))
                {
                    continue;
                }

                var product = await Db.Products.FirstOrDefaultAsync(x => x.Code == code);

                if (product is null && int.TryParse(code, out var id))
                {
                    product = await Db.Products.FirstOrDefaultAsync(x => x.Id == id && (x.Code == null || x.Code == ""));
                }

                if (product is null)
                {
                    missing++;
                    continue;
                }

                var sale = saleColumn > 0 ? ReadPrice(row.Cell(saleColumn)) : null;
                var cost = costColumn > 0 ? ReadPrice(row.Cell(costColumn)) : null;

                if (sale is not null)
                {
                    product.SalePrice = sale.Value;
                }

                if (cost is not null)
                {
                    product.CostPrice = cost.Value;
                }

                updated++;
            }

            await Db.SaveChangesAsync();
            await LoadProducts();

            Toasts.ShowSuccess($"قیمت {updated} کالا به‌روزرسانی شد" + (missing > 0 ? $" — {missing} کد در سیستم پیدا نشد" : ""));
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خواندن فایل قیمت‌ها: {ex.Message}");
        }
    }

    /// <summary>خواندن عدد از سلول اکسل — چه عددی باشد و چه متن با جداکنندهٔ هزار</summary>
    private static decimal? ReadPrice(ClosedXML.Excel.IXLCell cell)
    {
        if (cell is null || cell.IsEmpty())
        {
            return null;
        }

        if (cell.DataType == ClosedXML.Excel.XLDataType.Number)
        {
            return cell.GetValue<decimal>();
        }

        var builder = new System.Text.StringBuilder();

        foreach (var ch in cell.GetString())
        {
            if (ch is >= '0' and <= '9')
            {
                builder.Append(ch);
            }
            else if (ch is >= '۰' and <= '۹')
            {
                builder.Append((char)('0' + (ch - '۰')));
            }
            else if (ch == '.')
            {
                builder.Append('.');
            }
        }

        return decimal.TryParse(
            builder.ToString(),
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var value)
            ? value
            : null;
    }

    private async Task ExportExcel()
    {
        if (!Can(Permissions.ExportExcel))
        {
            Toasts.ShowError("شما اجازهٔ گرفتن خروجی اکسل را ندارید");
            return;
        }

        try
        {
            isExporting = true;

            var data = filteredProducts;

            var columns = new Dictionary<string, Func<Product, object?>>
            {
                ["کد"] = p => p.Code ?? p.Id.ToString(),
                ["نام کالا"] = p => p.Name,
                ["بارکد"] = p => p.Barcode,
                ["دسته"] = p => p.Category != null ? p.Category.Name : "—",
                ["واحد"] = p => p.UnitTitle,
                ["قیمت فروش"] = p => p.SalePrice.ToString("N0", CultureInfo.InvariantCulture),
                ["بهای خرید"] = p => p.CostPrice.ToString("N0", CultureInfo.InvariantCulture),
                ["سود هر واحد"] = p => p.ProfitPerUnit.ToString("N0", CultureInfo.InvariantCulture),
                ["موجودی"] = p => p.Quantity,
                ["حد سفارش"] = p => p.ReorderLevel,
                ["وضعیت"] = p => p.StockStatus,
                ["ارزش موجودی"] = p => p.StockValue.ToString("N0", CultureInfo.InvariantCulture),
                ["فعال"] = p => p.IsActive ? "بله" : "خیر",
                ["توضیحات"] = p => p.Description
            };

            var titleParts = new List<string> { "شناسنامهٔ کالاها" };

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                var catName = categoryFilter == "0"
                    ? "بدون دسته"
                    : categories.FirstOrDefault(c => c.Id.ToString() == categoryFilter)?.Name ?? "؟";
                titleParts.Add($"دسته: {catName}");
            }

            if (!string.IsNullOrWhiteSpace(stockFilter))
            {
                var stockName = stockFilter switch
                {
                    "low" => "نیاز به سفارش",
                    "out" => "ناموجود",
                    "ok" => "موجودی سالم",
                    _ => "غیرفعال"
                };
                titleParts.Add($"وضعیت: {stockName}");
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                titleParts.Add($"جستجو: «{searchTerm}»");
            }

            titleParts.Add($"تاریخ: {GetPersianDateTimeString()}");

            var title = string.Join("  |  ", titleParts);

            var bytes = Excel.Export(data, "کالاها", columns, title);
            var base64 = Convert.ToBase64String(bytes);

            var pc = new PersianCalendar();
            var now = DateTime.Now;
            var fileName = $"Products_{pc.GetYear(now):0000}{pc.GetMonth(now):00}{pc.GetDayOfMonth(now):00}_{now:HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خروجی Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetPersianDateTimeString()
    {
        var pc = new PersianCalendar();
        var now = DateTime.Now;
        return $"{pc.GetYear(now):0000}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00} - {now:HH:mm}";
    }

    private int GetProgressPercent(Product p)
    {
        if (_maxQuantity <= 0) return 0;
        var percent = (int)Math.Round((double)p.Quantity / _maxQuantity * 100);
        return Math.Clamp(percent, 0, 100);
    }

    private string GetProgressColor(Product p)
    {
        var percent = GetProgressPercent(p);
        if (percent <= 33) return "stock-bar-red";
        if (percent <= 66) return "stock-bar-yellow";
        return "stock-bar-green";
    }

    private static decimal ParseNum(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return 0m;
        }

        var clean = text.Trim().Replace("٫", ".").Replace("٬", "").Replace(",", "");
        return decimal.TryParse(clean, NumberStyles.Any, CultureInfo.InvariantCulture, out var value) ? value : 0m;
    }

    private static string Money(decimal value) => value.ToString("N0", Fa).Replace(",", ".") + " ریال";

    private static string? NullIfEmpty(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

