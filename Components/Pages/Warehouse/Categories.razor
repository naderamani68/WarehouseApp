@page "/categories"
@attribute [Authorize]
@inherits PageBase
@rendermode InteractiveServer
@inject IJSRuntime JS
@using WarehouseApp.Services
@using System.Globalization
@inject ExcelService Excel
@inject ToastService Toasts

<PageTitle>دسته‌بندی‌ها | WarehouseApp</PageTitle>

<h3 class="mb-3">📁 مدیریت دسته‌بندی محصولات</h3>

@* ===== فرم افزودن/ویرایش ===== *@
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                @(editingCategory == null ? "➕ افزودن دسته جدید" : $"✏️ ویرایش دسته: {editingCategory.Name}")
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label">نام دسته: <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="newName" placeholder="مثلاً: لوازم برقی" />
                </div>

                <div class="mb-3">
                    <label class="form-label">دستهٔ مادر:</label>
                    <select class="form-select" @bind="newParentId">
                        <option value="0">— بدون مادر (دستهٔ اصلی) —</option>

                        @foreach (var option in ParentOptions)
                        {
                            <option value="@option.Id">@option.Label</option>
                        }
                    </select>
                    <div class="text-muted small mt-1">
                        اگر دستهٔ مادر انتخاب کنی، این دسته زیردستهٔ آن می‌شود و در فروشگاه زیر همان دسته دیده می‌شود.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">توضیحات:</label>
                    <textarea class="form-control" rows="3" @bind="newDescription"
                              placeholder="توضیحات اختیاری..."></textarea>
                </div>

                @if (editingCategory == null && Can(Permissions.ManageCategories))
                {
                    <button class="btn btn-primary" @onclick="AddCategory">➕ افزودن</button>
                }
                else if (Can(Permissions.ManageCategories))
                {
                    <button class="btn btn-success" @onclick="SaveEdit">💾 ذخیره تغییرات</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit">انصراف</button>
                }
@* ===== پیام‌های شناور — کنار دکمهٔ ثبت ===== *@
<ToastHost Inline="true" />

            </div>
        </div>
    </div>
</div>
@* ===== جدول دسته‌ها ===== *@
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>📋 لیست دسته‌ها (@categories.Count)</span>
                <div class="d-flex gap-2" style="width: 60%;">
                    <input class="form-control form-control-sm"
                           placeholder="🔍 جستجو..."
                           @bind="searchTerm" @bind:event="oninput" />
                    @if (Can(Permissions.ManageCategories))
                    {
                        <label for="categoryImportFile" class="btn btn-sm btn-outline-success text-nowrap mb-0" title="ورود گروهی دسته‌بندی‌ها از فایل اکسل">
                            <i class="bi bi-upload"></i>
                        </label>
                        <InputFile id="categoryImportFile" OnChange="ImportCategories" accept=".xlsx,.xlsm" class="d-none" />

                        <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="DownloadCategoryTemplate" title="فایل نمونهٔ ورود دسته‌بندی‌ها">
                            <i class="bi bi-file-earmark-arrow-down"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-success text-nowrap" @onclick="ExportExcel" disabled="@(!Can(Permissions.ExportExcel) || isExporting)">
                        @if (isExporting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel"></i>
                            <span class="ms-1">خروجی اکسل</span>
                        }
                    </button>
                </div>
            </div>
            <div class="card-body p-0">

                @if (loading)
                {
                    <div class="text-center p-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <div class="mt-2 text-muted">در حال بارگذاری...</div>
                    </div>
                }
                else if (!FilteredCategories.Any())
                {
                    <div class="text-center p-5 text-muted">
                        <div style="font-size: 3rem;">📭</div>
                        <p class="mt-2 mb-0">
                            @(string.IsNullOrWhiteSpace(searchTerm)
                                ? "هنوز هیچ دسته‌ای ثبت نشده است."
                                : "دسته‌ای با این عنوان پیدا نشد.")
                        </p>
                        @if (string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <small>برای شروع، از فرم سمت راست یک دسته اضافه کنید.</small>
                        }
                    </div>
                }
                else
                {
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;">#</th>
                                <th>نام دسته</th>
                                <th>توضیحات</th>
                                <th style="width: 140px;" class="text-center">تعداد محصولات</th>
                                <th style="width: 180px;" class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int row = 1;
                            }
                            @foreach (var cat in FilteredCategories)
                            {
                                <tr>
                                    <td>@row</td>
                                    <td><strong>@cat.Name</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(cat.Description) ? "-" : cat.Description)</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark">@cat.ProductCount</span>
                                    </td>
                                    <td class="text-center">
                                        @if (Can(Permissions.ManageCategories))
                                        {
                                            <button class="btn btn-sm btn-warning" @onclick="() => StartEdit(cat)">✏️ ویرایش</button>
                                        }
                                        @if (Can(Permissions.DeleteCategories))
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(cat)">🗑️ حذف</button>
                                        }
                                    </td>
                                </tr>
                                row++;
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    </div>
</div>
@code {
    // ===== مدل نمایشی برای جدول =====
    private class CategoryListItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int ProductCount { get; set; }
        public int? ParentId { get; set; }
        public string? ParentName { get; set; }
    }

    // ===== حالت‌های صفحه =====
    private List<CategoryListItem> categories = new();
    private Category? editingCategory = null;

    private string? newName;
    private string? newDescription;
    private int newParentId;

    private string? searchTerm;
    private bool loading = true;

    private bool isExporting = false;   // 🆕

    // ===== فیلتر زنده =====
    private IEnumerable<CategoryListItem> FilteredCategories =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? categories
            : categories.Where(c =>
                c.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (c.Description ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    // ===== چرخه‌ی حیات =====
    protected override async Task OnPageInitializedAsync()
    {
        await LoadCategories();
    }

    // ===== بارگذاری =====
    private async Task LoadCategories()
    {
        loading = true;
        categories = await Db.Categories
            .Include(c => c.Parent)
            .OrderBy(c => c.Name)
            .Select(c => new CategoryListItem
                {
                    Id = c.Id,
                    Name = c.Name,
                    Description = c.Description,
                    ProductCount = c.Products.Count,
                    ParentId = c.ParentId,
                    ParentName = c.Parent != null ? c.Parent.Name : null
                })
            .ToListAsync();
        loading = false;
    }

    // ===== افزودن =====
    private async Task AddCategory()
    {
        if (!Can(Permissions.ManageCategories))
        {
            Toasts.ShowError("شما اجازهٔ افزودن دسته را ندارید");
            return;
        }

        if (string.IsNullOrWhiteSpace(newName))
        {
            Toasts.ShowError("نام دسته نمی‌تواند خالی باشد.");
            return;
        }

        try
        {
            var cat = new Category
                {
                    Name = newName.Trim(),
                    Description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim(),
                    ParentId = newParentId > 0 ? newParentId : null
                };

            Db.Categories.Add(cat);
            await Db.SaveChangesAsync();
            await LoadCategories();

            await AuditAsync("افزودن", "دسته‌بندی", cat.Id, $"دستهٔ «{cat.Name}» ساخته شد");
            Toasts.ShowSuccess($"دسته «{cat.Name}» با موفقیت اضافه شد ✅");
            ResetForm();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در افزودن: {ex.Message}");
        }
    }

    // ===== شروع ویرایش =====
    private void StartEdit(CategoryListItem item)
    {
        editingCategory = new Category
            {
                Id = item.Id,
                Name = item.Name,
                Description = item.Description
            };
        newName = item.Name;
        newDescription = item.Description;
        newParentId = item.ParentId ?? 0;
    }

    // ===== ذخیره‌ی ویرایش =====
    private async Task SaveEdit()
    {
        if (!Can(Permissions.ManageCategories))
        {
            Toasts.ShowError("شما اجازهٔ ویرایش دسته را ندارید");
            return;
        }

        if (editingCategory == null) return;

        if (IsOwnBranch(newParentId))
        {
            Toasts.ShowError("این دسته نمی‌تواند زیردستهٔ خودش یا زیردسته‌هایش شود.");
            return;
        }

        if (string.IsNullOrWhiteSpace(newName))
        {
            Toasts.ShowError("نام دسته نمی‌تواند خالی باشد.");
            return;
        }

        try
        {
            var entity = await Db.Categories.FindAsync(editingCategory.Id);
            if (entity == null)
            {
                Toasts.ShowError("دسته یافت نشد.");
                return;
            }

            entity.Name = newName.Trim();
            entity.Description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim();
            entity.ParentId = newParentId > 0 ? newParentId : null;

            await Db.SaveChangesAsync();
            await LoadCategories();

            await AuditAsync("ویرایش", "دسته‌بندی", entity.Id, $"دستهٔ «{entity.Name}» ویرایش شد");
            Toasts.ShowSuccess($"دسته «{entity.Name}» با موفقیت ویرایش شد ✅");
            CancelEdit();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ویرایش: {ex.Message}");
        }
    }

    // ===== انصراف =====
    private void CancelEdit()
    {
        editingCategory = null;
        ResetForm();
    }

    // ===== حذف =====
    private async Task DeleteCategory(CategoryListItem item)
    {
        if (!Can(Permissions.DeleteCategories))
        {
            Toasts.ShowError("شما اجازهٔ حذف دسته را ندارید");
            return;
        }

        var message = $"آیا از حذف دسته «{item.Name}» مطمئن هستید؟";
        if (item.ProductCount > 0)
        {
            message += $"\n\n⚠️ این دسته {item.ProductCount} محصول دارد. محصولات بدون دسته خواهند شد.";
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", message);
        if (!confirmed) return;

        try
        {
            var entity = await Db.Categories.FindAsync(item.Id);
            if (entity == null) return;

            Db.Categories.Remove(entity);
            await Db.SaveChangesAsync();
            await LoadCategories();

            await AuditAsync("حذف", "دسته‌بندی", item.Id, $"دستهٔ «{item.Name}» حذف شد");
            Toasts.ShowSuccess($"دسته «{item.Name}» حذف شد 🗑️");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در حذف: {ex.Message}");
        }
    }

    // ===== ریست فرم =====
    private void ResetForm()
    {
        newName = string.Empty;
        newDescription = string.Empty;
        newParentId = 0;
    }

    /// <summary>آیا دستهٔ انتخابی، خودِ این دسته یا یکی از زیردسته‌هایش است؟</summary>
    private bool IsOwnBranch(int parentId)
    {
        if (parentId <= 0 || editingCategory is null) { return false; }

        var current = parentId;

        for (var step = 0; step < 20; step++)
        {
            if (current == editingCategory.Id) { return true; }

            var node = categories.FirstOrDefault(c => c.Id == current);

            if (node?.ParentId is null or 0) { return false; }

            current = node.ParentId.Value;
        }

        return false;
    }

    /// <summary>گزینه‌های دستهٔ مادر — تورفته و بدون خودِ دسته</summary>
    private List<(int Id, string Label)> ParentOptions
    {
        get
        {
            var result = new List<(int, string)>();

            Add(null, 0);

            return result;

            void Add(int? parentId, int depth)
            {
                foreach (var item in categories.Where(c => c.ParentId == parentId).OrderBy(c => c.Name))
                {
                    if (editingCategory is not null && item.Id == editingCategory.Id) { continue; }

                    result.Add((item.Id, string.Concat(Enumerable.Repeat("— ", depth)) + item.Name));

                    Add(item.Id, depth + 1);
                }
            }
        }
    }

    // ===== 🆕 خروجی Excel =====
        /// <summary>دانلود فایل نمونهٔ ورود دسته‌بندی‌ها</summary>
    private async Task DownloadCategoryTemplate()
    {
        try
        {
            var bytes = await WarehouseApp.Services.ExcelTemplates.CategoriesAsync(DbFactory);
            await JS.InvokeVoidAsync("downloadFileFromBase64", "نمونه-ورود-دسته‌بندیها.xlsx", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در ساخت فایل نمونه: {ex.Message}");
        }
    }

    /// <summary>ورود گروهی دسته‌بندی‌ها از فایل اکسل</summary>
    private async Task ImportCategories(InputFileChangeEventArgs e)
    {
        if (!Can(Permissions.ManageCategories))
        {
            Toasts.ShowError("شما اجازهٔ افزودن دسته‌بندی را ندارید");
            return;
        }

        if (e.File is null)
        {
            return;
        }

        try
        {
            using var stream = await WarehouseApp.Services.ExcelService.CopyUploadAsync(e.File.OpenReadStream(10 * 1024 * 1024));
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            memory.Position = 0;

            var service = new WarehouseApp.Services.ExcelImportService(Db);
            var result = await service.ImportCategoriesAsync(memory);

            Toasts.ShowSuccess(result.Summary);

            foreach (var note in result.Notes)
            {
                Toasts.ShowSuccess(note);
            }

            await AuditAsync("ورود از اکسل", "دسته‌بندی", 0, result.Summary);
            await LoadCategories();
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خواندن فایل: {ex.Message}");
        }
    }
private async Task ExportExcel()
    {
        if (!Can(Permissions.ExportExcel))
        {
            Toasts.ShowError("شما اجازهٔ گرفتن خروجی اکسل را ندارید");
            return;
        }

        try
        {
            isExporting = true;

            // ✅ فقط دسته‌های فیلترشده (بر اساس جستجو)
            var data = FilteredCategories.ToList();

            var columns = new Dictionary<string, Func<CategoryListItem, object?>>
                {
                    ["کد"] = c => c.Id,
                    ["نام دسته"] = c => c.Name,
                    ["توضیحات"] = c => c.Description,
                    ["تعداد محصولات"] = c => c.ProductCount
                };

            // ===== ساخت عنوان پویا =====
            var titleParts = new List<string> { "گزارش دسته‌بندی محصولات" };

            // فیلتر جستجو
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                titleParts.Add($"جستجو: «{searchTerm}»");
            }

            // تاریخ شمسی
            titleParts.Add($"تاریخ: {GetPersianDateTimeString()}");

            var title = string.Join("  |  ", titleParts);

            // ===== خروجی =====
            var bytes = Excel.Export(data, "دسته‌بندی‌ها", columns, title);
            var base64 = Convert.ToBase64String(bytes);

            // نام فایل با تاریخ شمسی
            var pc = new PersianCalendar();
            var now = DateTime.Now;
            var fileName = $"Categories_{pc.GetYear(now):0000}{pc.GetMonth(now):00}{pc.GetDayOfMonth(now):00}_{now:HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خروجی Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetPersianDateTimeString()
    {
        var pc = new PersianCalendar();
        var now = DateTime.Now;
        return $"{pc.GetYear(now):0000}/{pc.GetMonth(now):00}/{pc.GetDayOfMonth(now):00} - {now:HH:mm}";
    }
}