@page "/reports"
@attribute [Authorize]
@inherits PageBase
@rendermode InteractiveServer

@using WarehouseApp.Data
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using WarehouseApp.Services
@inject ExcelService Excel
@inject ToastService Toasts
@inject IJSRuntime JS

<h3>📊 داشبورد گزارش‌ها</h3>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">📦 تعداد محصولات</h5>
                <p class="card-text display-4">@totalProducts</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">🏭 تعداد انبارها</h5>
                <p class="card-text display-4">@totalWarehouses</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">📊 کل موجودی</h5>
                <p class="card-text display-4">@totalStock</p>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">📥 ورودهای امروز</h5>
                <p class="card-text display-5">@todayIn</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-white bg-danger">
            <div class="card-body">
                <h5 class="card-title">📤 خروج‌های امروز</h5>
                <p class="card-text display-5">@todayOut</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-warning">
        <h5>⚠️ محصولات کم‌موجود (کمتر از ۵)</h5>
    </div>
    <div class="card-body">
        @if (lowStockProducts.Count == 0)
        {
            <p class="text-muted">همه‌ی محصولات موجودی کافی دارند ✅</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>نام محصول</th>
                        <th>توضیحات</th>
                        <th>موجودی</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in lowStockProducts)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@(p.Description ?? "-")</td>
                            <td><strong class="text-danger">@p.Quantity</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <h5>📈 ۱۰ حرکت اخیر</h5>
    </div>
    <div class="card-body">
        @if (recentMovements.Count == 0)
        {
            <p class="text-muted">هنوز حرکتی ثبت نشده است</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th>محصول</th>
                        <th>انبار</th>
                        <th>نوع</th>
                        <th>تعداد</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in recentMovements)
                    {
                        <tr>
                            <td>@m.MovementDate.ToString("MM/dd HH:mm")</td>
                            <td>@(m.Product?.Name ?? "-")</td>
                            <td>@(m.Warehouse?.Name ?? "-")</td>
                            <td>
                                @if (m.Type == MovementType.In)
                                {
                                    <span class="badge bg-success">ورود</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">خروج</span>
                                }
                            </td>
                            <td>@m.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-secondary text-white">
        <h5>🏆 محصولات پرفروش (بیشترین خروج)</h5>
    </div>
    <div class="card-body">
        @if (topProducts.Count == 0)
        {
            <p class="text-muted">هنوز خروجی ثبت نشده است</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>نام محصول</th>
                        <th>مجموع خروج</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                    }
                    @foreach (var item in topProducts)
                    {
                        <tr>
                            <td>@rank</td>
                            <td>@item.ProductName</td>
                            <td><strong>@item.TotalOut</strong></td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* ================= موجودی کالا در انبارها ================= *@
<div class="card mb-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">🏬 موجودی کالا در انبارها</h5>
        <button type="button" class="btn btn-sm btn-light" onclick="window.print()" title="چاپ همین گزارش">
            <i class="bi bi-printer me-1"></i>
            چاپ گزارش
        </button>
        <button class="btn btn-sm btn-light" @onclick="ExportStockExcel" disabled="@(!Can(Permissions.ExportExcel) || isStockExporting)">
            @if (isStockExporting)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال ساخت...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel"></i>
                <span>خروجی اکسل</span>
            }
        </button>
    </div>
    <div class="card-body">

        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <label class="form-label small mb-1">کالا</label>
                <select class="form-select form-select-sm" @bind="stockProductFilter">
                    <option value="0">— همهٔ کالاها —</option>
                    @foreach (var p in stockProducts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label small mb-1">انبار</label>
                <select class="form-select form-select-sm" @bind="stockWarehouseFilter">
                    <option value="0">— همهٔ انبارها —</option>
                    @foreach (var w in stockWarehouses)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-center">
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" id="onlyNonZero" @bind="onlyNonZeroStock" />
                    <label class="form-check-label small" for="onlyNonZero">فقط غیرصفر</label>
                </div>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-sm btn-outline-secondary w-100" @onclick="ClearStockFilters">پاک‌کردن فیلترها</button>
            </div>
        </div>

        <div class="text-muted small mb-2">
            @filteredStockRows.Count ردیف &nbsp;|&nbsp;
            @foreach (var unitGroup in filteredStockRows.GroupBy(r => r.UnitName))
            {
                <span class="badge bg-secondary me-1">@unitGroup.Sum(x => x.Quantity) @unitGroup.Key</span>
            }
        </div>

        <div style="max-height: 420px; overflow-y: auto;">
            <table class="table table-sm table-striped mb-0">
                <thead class="table-light" style="position: sticky; top: 0;">
                    <tr>
                        <th>کالا</th>
                        <th>انبار</th>
                        <th style="width: 100px;">واحد</th>
                        <th style="width: 120px;">موجودی</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredStockRows.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">ردیفی با این فیلترها پیدا نشد</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in filteredStockRows)
                        {
                            <tr>
                                <td>@r.ProductName</td>
                                <td>@r.WarehouseName</td>
                                <td class="text-muted">@r.UnitName</td>
                                <td>
                                    @if (r.Quantity == 0)
                                    {
                                        <span class="text-muted">۰</span>
                                    }
                                    else
                                    {
                                        <strong>@r.Quantity</strong>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private int totalProducts;
    private int totalWarehouses;
    private int totalStock;
    private int todayIn;
    private int todayOut;

    private List<Product> lowStockProducts = new();
    private List<StockMovement> recentMovements = new();
    private List<TopProductItem> topProducts = new();

    // ===== موجودی کالا در انبارها =====
    private List<StockRow> stockRows = new();
    private List<Product> stockProducts = new();
    private List<Warehouse> stockWarehouses = new();
    private int stockProductFilter;
    private int stockWarehouseFilter;
    private bool onlyNonZeroStock = true;
    private bool isStockExporting;

    protected override async Task OnPageInitializedAsync()
    {
        if (!Can(Permissions.ViewReports))
        {
            Nav.NavigateTo("/access-denied", forceLoad: true);
            return;
        }

        // آمار کلی
        totalProducts = await Db.Products.CountAsync();
        totalWarehouses = await Db.Warehouses.CountAsync();
        totalStock = await Db.Products.SumAsync(p => (int?)p.Quantity) ?? 0;

        // ورود/خروج امروز
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);

        todayIn = await Db.StockMovements
            .Where(m => m.Type == MovementType.In
                     && m.MovementDate >= today
                     && m.MovementDate < tomorrow)
            .SumAsync(m => (int?)m.Quantity) ?? 0;

        todayOut = await Db.StockMovements
            .Where(m => m.Type == MovementType.Out
                     && m.MovementDate >= today
                     && m.MovementDate < tomorrow)
            .SumAsync(m => (int?)m.Quantity) ?? 0;

        // محصولات کم‌موجود
        lowStockProducts = await Db.Products
            .Where(p => p.Quantity < 5)
            .OrderBy(p => p.Quantity)
            .ToListAsync();

        // ۱۰ حرکت اخیر
        recentMovements = await Db.StockMovements
            .Include(m => m.Product)
            .Include(m => m.Warehouse)
            .OrderByDescending(m => m.MovementDate)
            .Take(10)
            .ToListAsync();

        // محصولات پرفروش
        var grouped = await Db.StockMovements
            .Where(m => m.Type == MovementType.Out)
            .Include(m => m.Product)
            .GroupBy(m => m.Product!.Name)
            .Select(g => new
            {
                ProductName = g.Key ?? "-",
                TotalOut = g.Sum(x => x.Quantity)
            })
            .OrderByDescending(x => x.TotalOut)
            .Take(5)
            .ToListAsync();

        topProducts = grouped
            .Select(x => new TopProductItem
                {
                    ProductName = x.ProductName,
                    TotalOut = x.TotalOut
                })
            .ToList();

        // ===== موجودی کالا در انبارها =====
        stockProducts = await Db.Products.OrderBy(p => p.Name).ToListAsync();
        stockWarehouses = await Db.Warehouses.Where(w => w.IsActive).OrderBy(w => w.Name).ToListAsync();

        var stockGrouped = await Db.StockMovements
            .GroupBy(m => new { m.ProductId, m.WarehouseId })
            .Select(g => new
            {
                g.Key.ProductId,
                g.Key.WarehouseId,
                ProductName = g.First().Product!.Name ?? "—",
                WarehouseName = g.First().Warehouse!.Name ?? "—",
                Quantity = g.Sum(x => x.Type == MovementType.In ? x.Quantity : -x.Quantity)
            })
            .ToListAsync();

        stockRows = stockGrouped
            .Select(x => new StockRow
            {
                ProductId = x.ProductId,
                WarehouseId = x.WarehouseId,
                ProductName = x.ProductName,
                WarehouseName = x.WarehouseName,
                Quantity = x.Quantity
            })
            .ToList();

        var unitById = stockProducts.ToDictionary(p => p.Id, p => p.UnitTitle);

        foreach (var row in stockRows)
        {
            row.UnitName = unitById.TryGetValue(row.ProductId, out var unitName) ? unitName : "عدد";
        }
    }

    private List<StockRow> filteredStockRows
    {
        get
        {
            var rows = stockRows
                .Where(r => stockProductFilter == 0 || r.ProductId == stockProductFilter)
                .Where(r => stockWarehouseFilter == 0 || r.WarehouseId == stockWarehouseFilter)
                .ToList();

            if (!onlyNonZeroStock)
            {
                // نمایش همهٔ ترکیب‌های کالا × انبار، حتی با موجودی صفر
                var existing = rows.Select(r => (r.ProductId, r.WarehouseId)).ToHashSet();
                var productsToShow = stockProducts.Where(p => stockProductFilter == 0 || p.Id == stockProductFilter);
                var warehousesToShow = stockWarehouses.Where(w => stockWarehouseFilter == 0 || w.Id == stockWarehouseFilter);

                foreach (var p in productsToShow)
                {
                    foreach (var w in warehousesToShow)
                    {
                        if (!existing.Contains((p.Id, w.Id)))
                        {
                            rows.Add(new StockRow
                            {
                                ProductId = p.Id,
                                WarehouseId = w.Id,
                                ProductName = p.Name ?? "—",
                                WarehouseName = w.Name,
                                Quantity = 0
                            });
                        }
                    }
                }
            }

            return rows
                .OrderBy(r => r.ProductName)
                .ThenBy(r => r.WarehouseName)
                .ToList();
        }
    }

    private void ClearStockFilters()
    {
        stockProductFilter = 0;
        stockWarehouseFilter = 0;
        onlyNonZeroStock = true;
    }

    private async Task ExportStockExcel()
    {
        if (!Can(Permissions.ExportExcel))
        {
            Toasts.ShowError("شما اجازهٔ گرفتن خروجی اکسل را ندارید");
            return;
        }

        try
        {
            isStockExporting = true;

            var data = filteredStockRows;

            var columns = new Dictionary<string, Func<StockRow, object?>>
            {
                ["کالا"] = r => r.ProductName,
                ["انبار"] = r => r.WarehouseName,
                ["واحد"] = r => r.UnitName,
                ["موجودی"] = r => r.Quantity
            };

            var pcNow = new PersianCalendar();
            var now = DateTime.Now;
            var title = $"موجودی کالا در انبارها  |  ردیف: {data.Count}  |  تاریخ: {pcNow.GetYear(now):0000}/{pcNow.GetMonth(now):00}/{pcNow.GetDayOfMonth(now):00}";

            var bytes = Excel.Export(data, "موجودی انبارها", columns, title);
            var base64 = Convert.ToBase64String(bytes);

            var fileName = $"StockByWarehouse_{pcNow.GetYear(now):0000}{pcNow.GetMonth(now):00}{pcNow.GetDayOfMonth(now):00}_{now:HHmm}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64);
            Toasts.ShowSuccess($"خروجی با {data.Count} ردیف ساخته شد");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"خطا در خروجی Excel: {ex.Message}");
        }
        finally
        {
            isStockExporting = false;
        }
    }

    private class StockRow
    {
        public int ProductId { get; set; }
        public int WarehouseId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public string WarehouseName { get; set; } = string.Empty;
        public string UnitName { get; set; } = string.Empty;
        public int Quantity { get; set; }
    }

    private class TopProductItem
    {
        public string ProductName { get; set; } = string.Empty;
        public int TotalOut { get; set; }
    }
}