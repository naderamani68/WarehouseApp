@inherits LayoutComponentBase
@using System.Globalization
@implements IDisposable
@inject IHttpContextAccessor HttpAccessor

<div class="page">
    @* چک‌باکس مخفی برای باز و بستن منوی کنار — فقط با CSS، بدون جاوااسکریپت *@
    <input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">

            @* ===== سمت راست: دکمه باز و بستن منو + دکمه خانه + نام اپ ===== *@
            <div class="d-flex align-items-center gap-3">
                <label for="sidebar-toggle" class="sidebar-toggle-btn" title="باز و بستن منوی کنار">
                    <i class="bi bi-list"></i>
                </label>
                <a class="btn btn-sm btn-outline-primary" href="/" title="بازگشت به صفحه اصلی">
                    <i class="bi bi-house-door-fill me-1"></i>
                    خانه
                </a>
                <span class="text-muted small">سیستم مدیریت انبار</span>
            </div>

            @* ===== سمت چپ: تم + تاریخ و ساعت زنده ===== *@
            <div class="d-flex align-items-center gap-3">

                @* ===== کاربر جاری ===== *@
                @if (IsLoggedIn)
                {
                    <a class="user-box" href="/profile" title="پروفایل من">
                        <span class="user-name">@CurrentUserName</span>
                        <span class="user-role">@CurrentRoleTitle</span>
                    </a>

                    <a class="logout-btn" href="/account/logout" title="خروج از حساب">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                }

                @* دکمه سوییچ تم (کامپوننت مستقل با rendermode خودش) *@
                <ThemeToggle />

                <span class="text-muted small">
                    <i class="bi bi-calendar3 me-1"></i>
                    @PersianDateString
                </span>
            </div>

        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    خطای غیرمنتظره‌ای رخ داد.
    <a href="" class="reload">بارگذاری مجدد</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // ===== کاربر جاری (خوانده‌شده از کوکی در هر درخواست) =====
    private System.Security.Claims.ClaimsPrincipal? CurrentUser => HttpAccessor.HttpContext?.User;

    private bool IsLoggedIn => CurrentUser?.Identity?.IsAuthenticated == true;

    private string CurrentUserName
    {
        get
        {
            if (!IsLoggedIn) return string.Empty;
            return CurrentUser!.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                   ?? CurrentUser.Identity?.Name
                   ?? "کاربر";
        }
    }

    private string CurrentRoleTitle
    {
        get
        {
            return CurrentUser?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
        }
    }

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        // هر ۳۰ ثانیه یک‌بار آپدیت می‌کنه
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(30));
    }

    private string PersianDateString
    {
        get
        {
            var pc = new PersianCalendar();
            var now = DateTime.Now;

            int year = pc.GetYear(now);
            int month = pc.GetMonth(now);
            int day = pc.GetDayOfMonth(now);
            int hour = now.Hour;
            int minute = now.Minute;

            string[] weekDays = { "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه", "شنبه" };
            string dayName = weekDays[(int)now.DayOfWeek];

            return $"{dayName} {year}/{month:00}/{day:00} - {hour:00}:{minute:00}";
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}