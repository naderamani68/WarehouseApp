@inject IHttpContextAccessor HttpAccessor
@inject AccessService Access
@using WarehouseApp.Services
@using WarehouseApp.Data

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">📦 انبار من</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-2" aria-hidden="true"></span>
                خانه
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">
                <span class="bi bi-person-circle me-2" aria-hidden="true"></span>
                پروفایل من
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="products">
                <span class="bi bi-box-seam me-2" aria-hidden="true"></span>
                محصولات
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categories">
                <span class="bi bi-tags-fill me-2" aria-hidden="true"></span>
                دسته‌بندی‌ها
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="warehouses">
                <span class="bi bi-building me-2" aria-hidden="true"></span>
                انبارها
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="movements">
                <span class="bi bi-arrow-left-right me-2" aria-hidden="true"></span>
                حرکات انبار
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reports">
                <span class="bi bi-bar-chart-fill me-2" aria-hidden="true"></span>
                گزارش‌ها
            </NavLink>
        </div>

        @* ===== بخش مشتریان، فروش و پیگیری (CRM) ===== *@
        @if (canViewCrm)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="crm" Match="NavLinkMatch.All">
                    <span class="bi bi-speedometer2 me-2" aria-hidden="true"></span>
                    داشبورد فروش
                </NavLink>
            </div>
        }

        @if (canViewParties)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="crm/parties">
                    <span class="bi bi-people me-2" aria-hidden="true"></span>
                    مشتریان و تأمین‌کنندگان
                </NavLink>
            </div>
        }

        @if (canViewCrm)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="crm/interactions">
                    <span class="bi bi-telephone-outbound me-2" aria-hidden="true"></span>
                    پیگیری‌ها
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="crm/opportunities">
                    <span class="bi bi-graph-up-arrow me-2" aria-hidden="true"></span>
                    فرصت‌های فروش
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="crm/orders">
                    <span class="bi bi-receipt me-2" aria-hidden="true"></span>
                    سفارش‌های فروش
                </NavLink>
            </div>
        }

        @* ===== آیتم‌های مدیریتی (بر اساس اختیار کاربر) ===== *@
        @if (canManageEmployees)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="employees">
                    <span class="bi bi-people-fill me-2" aria-hidden="true"></span>
                    کارمندان
                </NavLink>
            </div>
        }

        @if (canViewAuditLog)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="audit-log">
                    <span class="bi bi-clock-history me-2" aria-hidden="true"></span>
                    تاریخچهٔ عملیات
                </NavLink>
            </div>
        }

        @if (canManageRoles)         {             <div class="nav-item px-3">                 <NavLink class="nav-link" href="roles">                     <span class="bi bi-shield-lock-fill me-2" aria-hidden="true"></span>                     نقش‌ها و دسترسی‌ها                 </NavLink>             </div>         }

    </nav>
</div>

@code {
    private bool canManageRoles;
    private bool canManageEmployees;
    private bool canViewAuditLog;
    private bool canViewParties;
    private bool canViewCrm;

    protected override async Task OnInitializedAsync()
    {
        // اختیارات را یک‌بار می‌خوانیم و برای همهٔ آیتم‌های منو استفاده می‌کنیم
        var permissions = await Access.GetPermissionsAsync(HttpAccessor.HttpContext?.User);

        canManageEmployees = (permissions & Permissions.ManageEmployees) == Permissions.ManageEmployees;
        canManageRoles = (permissions & Permissions.ManageRoles) == Permissions.ManageRoles;
        canViewAuditLog = (permissions & Permissions.ViewAuditLog) == Permissions.ViewAuditLog;
        canViewParties = (permissions & Permissions.ViewParties) == Permissions.ViewParties;
        canViewCrm = (permissions & Permissions.ViewCrm) == Permissions.ViewCrm;
    }
}
