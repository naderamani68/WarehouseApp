@inject IHttpContextAccessor HttpAccessor
@inject AccessService Access
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Routing
@using WarehouseApp.Services
@using WarehouseApp.Data

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">📦 انبار من</a>
    </div>
</div>



<div class="nav-scrollable">
    <nav class="flex-column">

        @{
            var visibleSections = sections.Where(s => s.Items.Count > 0).ToList();
            var activeKey = ActiveSectionKey;
        }

        @for (var i = 0; i < visibleSections.Count; i++)
        {
            var grp = visibleSections[i];

            @if (i > 0)
            {
                <hr class="mx-3 my-1 opacity-25" />
            }

            @* عنصر details به‌صورت بومی مرورگر باز و بسته می‌شود — نیازی به کد تعاملی نیست *@
            <details class="nav-group" open="@(activeKey == grp.Key ? "open" : null)">
                <summary class="nav-group-header">
                    <span class="d-flex align-items-center">
                        <span class="bi @grp.Icon me-2" aria-hidden="true"></span>
                        <span>@grp.Title</span>
                    </span>
                    <span class="bi bi-chevron-down nav-group-chevron" aria-hidden="true"></span>
                </summary>

                @foreach (var item in grp.Items)
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="@item.Href"
                                 Match="@(item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 onclick="if (window.innerWidth < 641) { document.getElementById('sidebar-toggle').click(); }">
                            <span class="bi @item.Icon me-2" aria-hidden="true"></span>
                            @item.Title
                        </NavLink>
                    </div>
                }
            </details>
        }

    </nav>
</div>

@code {
    /// <summary>یک آیتم منو</summary>
    private record NavItem(string Title, string Href, string Icon, bool Exact = false);

    /// <summary>یک دستهٔ منو همراه آیتم‌هایش</summary>
    private record NavSection(string Key, string Title, string Icon, List<NavItem> Items);

    private bool canManageRoles;
    private bool canManageEmployees;
    private bool canViewAuditLog;
    private bool canViewParties;
    private bool canViewCrm;
    private bool canViewFinance;
    private bool canManageSettings;
    private bool canSalesPanel;

    private List<NavSection> sections = new();

    /// <summary>دستهٔ مربوط به صفحهٔ فعلی — فقط همین دسته به‌طور پیش‌فرض باز است</summary>
    private string? ActiveSectionKey
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');

            var found = sections.FirstOrDefault(s => s.Items.Any(item =>
                !string.IsNullOrEmpty(item.Href) &&
                path.StartsWith(item.Href, StringComparison.OrdinalIgnoreCase)));

            return found?.Key;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // اختیارات را یک‌بار می‌خوانیم و برای همهٔ آیتم‌های منو استفاده می‌کنیم
        var permissions = await Access.GetPermissionsAsync(HttpAccessor.HttpContext?.User);

        canManageEmployees = (permissions & Permissions.ManageEmployees) == Permissions.ManageEmployees;
        canManageRoles = (permissions & Permissions.ManageRoles) == Permissions.ManageRoles;
        canViewAuditLog = (permissions & Permissions.ViewAuditLog) == Permissions.ViewAuditLog;
        canViewParties = (permissions & Permissions.ViewParties) == Permissions.ViewParties;
        canViewCrm = (permissions & Permissions.ViewCrm) == Permissions.ViewCrm;
        canViewFinance = (permissions & Permissions.ViewFinance) == Permissions.ViewFinance;
        canManageSettings = (permissions & Permissions.ManageSettings) == Permissions.ManageSettings;
        canSalesPanel = (permissions & Permissions.SalesPanel) == Permissions.SalesPanel;

        BuildSections();
    }

    /// <summary>ساخت دسته‌های منو — هر بخش فقط اگر حداقل یک آیتم مجاز داشته باشد نمایش داده می‌شود</summary>
    private void BuildSections()
    {
        var general = new List<NavItem>
        {
            new("خانه", "", "bi-house-door-fill", Exact: true),
            new("پروفایل من", "profile", "bi-person-circle")
        };

        var warehouse = new List<NavItem>
        {
            new("کالاها", "products", "bi-box-seam"),
            new("دسته‌بندی‌ها", "categories", "bi-tags-fill"),
            new("انبارها", "warehouses", "bi-building"),
            new("حرکات انبار", "movements", "bi-arrow-left-right"),
            new("گزارش‌ها", "reports", "bi-bar-chart-fill")
        };

        var sales = new List<NavItem>();

        if (canViewCrm)
        {
            sales.Add(new NavItem("داشبورد فروش", "crm", "bi-speedometer2", Exact: true));
        }

        if (canSalesPanel && !canViewCrm)
        {
            sales.Add(new NavItem("سفارش‌های من", "sales", "bi-person-badge"));
        }

        if (canViewParties)
        {
            sales.Add(new NavItem("مشتریان و تأمین‌کنندگان", "crm/parties", "bi-people"));
        }

        if (canViewCrm)
        {
            sales.Add(new NavItem("پیگیری‌ها", "crm/interactions", "bi-telephone-outbound"));
            sales.Add(new NavItem("فرصت‌های فروش", "crm/opportunities", "bi-graph-up-arrow"));
            sales.Add(new NavItem("سفارش‌های فروش", "crm/orders", "bi-receipt"));
            sales.Add(new NavItem("کانال‌های فروش", "crm/channels", "bi-shop-window"));
            sales.Add(new NavItem("سفارش‌های من", "sales", "bi-person-badge"));
        }

        var finance = new List<NavItem>();

        if (canViewFinance)
        {
            finance.Add(new NavItem("وضعیت مالی", "finance", "bi-cash-coin", Exact: true));
            finance.Add(new NavItem("چک و سفته", "finance/cheques", "bi-journal-check"));
            finance.Add(new NavItem("بدهی و طلب", "finance/debts", "bi-arrow-left-right"));
            finance.Add(new NavItem("هزینه‌ها", "finance/expenses", "bi-wallet2"));
        }

        var admin = new List<NavItem>();

        if (canManageEmployees)
        {
            admin.Add(new NavItem("کارمندان", "employees", "bi-people-fill"));
        }

        if (canManageRoles)
        {
            admin.Add(new NavItem("نقش‌ها و دسترسی‌ها", "roles", "bi-shield-lock-fill"));
        }

        if (canViewAuditLog)
        {
            admin.Add(new NavItem("تاریخچهٔ عملیات", "audit-log", "bi-clock-history"));
        }

        if (canManageSettings)
        {
            admin.Add(new NavItem("تنظیمات", "settings", "bi-sliders"));
        }

        sections = new List<NavSection>
        {
            new("general", "عمومی", "bi-grid-1x2", general),
            new("warehouse", "انبار و کالا", "bi-box-seam", warehouse),
            new("sales", "فروش و پیگیری", "bi-graph-up-arrow", sales),
            new("finance", "مالی و حسابداری", "bi-cash-stack", finance),
            new("admin", "مدیریت سیستم", "bi-gear", admin)
        };
    }
}
