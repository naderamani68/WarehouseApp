<body>
    <Routes />

       @* اعمال تم قبل از رندر — جلوگیری از پرش اولیه *@
    <script>
        (function () {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <script src="_framework/blazor.web.js"></script>

    @* 🔧 اعمال مجدد تم بعد از هر Navigation — رفع مشکل تغییر تم بین صفحات *@
    <script>
        function reapplyTheme() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        }

        Blazor.addEventListener('enhancedload', reapplyTheme);
    </script>

    @* 🔧 به‌خاطر سپردن وضعیت منوی کنار (باز یا بسته) بین صفحه‌ها *@
    <script>
        function applySidebarState() {
            const box = document.getElementById('sidebar-toggle');
            if (!box) return;
            box.checked = localStorage.getItem('sidebarHidden') === 'true';
        }

        document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'sidebar-toggle') {
                localStorage.setItem('sidebarHidden', e.target.checked ? 'true' : 'false');
            }
        });

        applySidebarState();
        Blazor.addEventListener('enhancedload', applySidebarState);
    </script>

    <script src="js/fileDownload.js"></script>
    <script src="js/latinInput.js"></script>

    <script src="_content/Blazor-ApexCharts/js/apexcharts.esm.js" type="module"></script>
    <script src="_content/Blazor-ApexCharts/js/blazor-apexcharts.js" type="module"></script>

</body>

</html>